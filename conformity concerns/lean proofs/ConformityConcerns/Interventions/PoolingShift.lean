import ConformityConcerns.Basic
import Mathlib.Probability.Distributions.Gaussian.HasGaussianLaw.Independence
import Mathlib.Probability.ConditionalExpectation
import Mathlib.Probability.HasLaw

/-!
# Proposition 4 (Effect of Interventions on the Pooling Decision)

Prior beliefs are uncorrelated: `θ ~ N(0, σ²_θ)`, `μ ~ N(0, σ²_μ)`, and player 1's noise
`ε₁, ν₁ ~ N(0,1)`, all independent. Period 1 is revealing with
`a₁ = λ_s s₁ + λ_v v₁` (`s₁ = θ + ε₁`, `v₁ = μ + ν₁`, `λ_s, λ_v > 0`), and period 2 pools on
`a*(a₁) = γ₂ E(θ | a₁) + E(μ | a₁)` (Social Optimality pools on `E(Z₂ | h²)`).
Revealing `μ` (resp. `θ`) changes the pooling decision to `γ₂ E(θ | a₁, μ) + μ`
(resp. `γ₂ θ + E(μ | a₁, θ)`). Conditional expectations are Mathlib's `condExp` with respect to
the σ-algebra generated by the conditioning variables; the identities hold almost surely.

The random variables are assumed measurable (they are the model's random variables); the
result is `prop4`, proved via `prop4_of_measurable`.
-/

namespace CC

open MeasureTheory ProbabilityTheory
open scoped NNReal

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]

namespace GaussReg

section Regression

variable {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [MeasurableSpace F] [BorelSpace F]
  [CompleteSpace F] [SecondCountableTopology F]

/-- Gaussian regression: if `(X, Y)` is jointly Gaussian and the residual `X - L(Y)` is
uncorrelated with every linear functional of `Y`, then `E(X | Y) = L(Y) + E(X - L(Y))`. -/
lemma condExp_gaussian_regression {X : Ω → ℝ} {Y : Ω → F} (hX : Measurable X) (hY : Measurable Y)
    (hXY : HasGaussianLaw (fun ω => (X ω, Y ω)) P) (L : F →L[ℝ] ℝ) (c : ℝ)
    (hmean : ∫ ω, (X ω - L (Y ω)) ∂P = c)
    (hcov : ∀ L₂ : StrongDual ℝ F, cov[fun ω => X ω - L (Y ω), fun ω => L₂ (Y ω); P] = 0) :
    P[X | MeasurableSpace.comap Y inferInstance] =ᵐ[P] fun ω => L (Y ω) + c := by
  set R : Ω → ℝ := fun ω => X ω - L (Y ω) with hR
  have hRm : Measurable R := hX.sub (L.measurable.comp hY)
  let M : ℝ × F →L[ℝ] ℝ × F :=
    (ContinuousLinearMap.fst ℝ ℝ F - L.comp (ContinuousLinearMap.snd ℝ ℝ F)).prod
      (ContinuousLinearMap.snd ℝ ℝ F)
  have hRY : HasGaussianLaw (fun ω => (R ω, Y ω)) P := by
    have h := hXY.map M
    have e : (M ∘ fun ω => (X ω, Y ω)) = fun ω => (R ω, Y ω) := by
      funext ω; simp [M, R]
    rwa [e] at h
  have hind : IndepFun R Y P := by
    refine hRY.indepFun_of_covariance_strongDual fun L₁ L₂ => ?_
    have e : (L₁ ∘ R) = fun ω => R ω * L₁ 1 := by
      funext ω
      simp only [Function.comp_apply]
      rw [← smul_eq_mul, ← L₁.map_smul, smul_eq_mul, mul_one]
    rw [e, covariance_mul_const_left]
    have h := hcov L₂
    simp only [Function.comp_def]
    rw [h, zero_mul]
  have hmR : MeasurableSpace.comap R inferInstance ≤ mΩ := hRm.comap_le
  have hmY : MeasurableSpace.comap Y inferInstance ≤ mΩ := hY.comap_le
  have h1 : P[R | MeasurableSpace.comap Y inferInstance] =ᵐ[P] fun _ => ∫ ω, R ω ∂P :=
    condExp_indep_eq hmR hmY (comap_measurable R).stronglyMeasurable
      ((IndepFun_iff_Indep R Y P).1 hind)
  have hRint : Integrable R P := hRY.fst.integrable
  have hLint : Integrable (fun ω => L (Y ω)) P := (hXY.snd.map L).integrable
  have h2 : P[fun ω => L (Y ω) | MeasurableSpace.comap Y inferInstance] = fun ω => L (Y ω) :=
    condExp_of_stronglyMeasurable hmY (L.measurable.comp (comap_measurable Y)).stronglyMeasurable
      hLint
  have hXeq : X = R + fun ω => L (Y ω) := by funext ω; simp [R]
  rw [hXeq]
  filter_upwards [condExp_add hRint hLint (MeasurableSpace.comap Y inferInstance), h1] with ω h h'
  rw [h, Pi.add_apply, h', h2, hmean]
  ring

end Regression

section Lin

variable {ι : Type*} [Fintype ι] (Xs : ι → Ω → ℝ)

/-- A linear combination `∑ uᵢ Xᵢ`. -/
def lin (u : ι → ℝ) : Ω → ℝ := fun ω => ∑ i, u i * Xs i ω

/-- The continuous linear functional `x ↦ ∑ uᵢ xᵢ`. -/
noncomputable def linCLM (u : ι → ℝ) : (ι → ℝ) →L[ℝ] ℝ := ∑ i, u i • ContinuousLinearMap.proj i

lemma linCLM_apply (u : ι → ℝ) (x : ι → ℝ) : linCLM u x = ∑ i, u i * x i := by
  simp [linCLM]

variable {Xs}

lemma lin_measurable (hm : ∀ i, Measurable (Xs i)) (u : ι → ℝ) : Measurable (lin Xs u) :=
  Finset.measurable_sum _ fun i _ => (hm i).const_mul (u i)

lemma integral_lin (hL2 : ∀ i, MemLp (Xs i) 2 P) (h0 : ∀ i, ∫ ω, Xs i ω ∂P = 0) (u : ι → ℝ) :
    ∫ ω, lin Xs u ω ∂P = 0 := by
  unfold lin
  rw [integral_finsetSum _ fun i _ => ((hL2 i).integrable one_le_two).const_mul (u i)]
  simp [integral_const_mul, h0]

lemma cov_lin (hL2 : ∀ i, MemLp (Xs i) 2 P) (hind : iIndepFun Xs P) (u w : ι → ℝ) :
    cov[lin Xs u, lin Xs w; P] = ∑ i, u i * w i * Var[Xs i; P] := by
  unfold lin
  rw [covariance_fun_sum_fun_sum (fun i => (hL2 i).const_mul (u i))
    (fun j => (hL2 j).const_mul (w j))]
  simp_rw [covariance_const_mul_left, covariance_const_mul_right]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Finset.sum_eq_single i]
  · rw [covariance_self (hL2 i).aemeasurable]; ring
  · intro j _ hji
    rw [(hind.indepFun hji.symm).covariance_eq_zero (hL2 i) (hL2 j)]; ring
  · simp

omit mΩ in
lemma lin_sub (u w : ι → ℝ) (b : ℝ) (ω : Ω) :
    lin Xs u ω - b * lin Xs w ω = lin Xs (fun i => u i - b * w i) ω := by
  simp only [lin, Finset.mul_sum, ← Finset.sum_sub_distrib]
  exact Finset.sum_congr rfl fun i _ => by ring

omit mΩ in
lemma lin_sub2 (u w₁ w₂ : ι → ℝ) (b₁ b₂ : ℝ) (ω : Ω) :
    lin Xs u ω - (b₁ * lin Xs w₁ ω + b₂ * lin Xs w₂ ω) =
      lin Xs (fun i => u i - b₁ * w₁ i - b₂ * w₂ i) ω := by
  simp only [lin, Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
  exact Finset.sum_congr rfl fun i _ => by ring

omit mΩ in
lemma lin_add2 (w₁ w₂ : ι → ℝ) (α β : ℝ) (ω : Ω) :
    α * lin Xs w₁ ω + β * lin Xs w₂ ω = lin Xs (fun i => α * w₁ i + β * w₂ i) ω := by
  simp only [lin, Finset.mul_sum, ← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl fun i _ => by ring

variable (hm : ∀ i, Measurable (Xs i)) (hL2 : ∀ i, MemLp (Xs i) 2 P)
  (h0 : ∀ i, ∫ ω, Xs i ω ∂P = 0) (hind : iIndepFun Xs P)
  (hG : HasGaussianLaw (fun ω => (Xs · ω)) P)
include hm hL2 h0 hind hG

/-- Regression on one linear combination. -/
lemma condExp_lin1 (u w : ι → ℝ) (b : ℝ)
    (hip : ∑ i, (u i - b * w i) * w i * Var[Xs i; P] = 0) :
    P[lin Xs u | MeasurableSpace.comap (lin Xs w) inferInstance] =ᵐ[P]
      fun ω => b * lin Xs w ω := by
  have hXY : HasGaussianLaw (fun ω => (lin Xs u ω, lin Xs w ω)) P := by
    have h := hG.map ((linCLM u).prod (linCLM w))
    have e : (((linCLM u).prod (linCLM w)) ∘ fun ω => (Xs · ω)) =
        fun ω => (lin Xs u ω, lin Xs w ω) := by
      funext ω; simp [linCLM_apply, lin]
    rwa [e] at h
  have := condExp_gaussian_regression (lin_measurable hm u) (lin_measurable hm w) hXY
    (b • ContinuousLinearMap.id ℝ ℝ) 0 ?_ ?_
  · filter_upwards [this] with ω hω
    rw [hω]; simp
  · simp only [smul_apply, ContinuousLinearMap.id_apply, smul_eq_mul,
      lin_sub]
    exact integral_lin hL2 h0 _
  · intro L₂
    simp only [smul_apply, ContinuousLinearMap.id_apply, smul_eq_mul,
      lin_sub]
    have e : (fun ω => L₂ (lin Xs w ω)) = fun ω => lin Xs w ω * L₂ 1 := by
      funext ω; rw [← smul_eq_mul, ← L₂.map_smul, smul_eq_mul, mul_one]
    rw [e, covariance_mul_const_right]
    have : (fun ω => lin Xs (fun i => u i - b * w i) ω) = lin Xs (fun i => u i - b * w i) := rfl
    rw [this, cov_lin hL2 hind, hip, zero_mul]

/-- Regression on two linear combinations. -/
lemma condExp_lin2 (u w₁ w₂ : ι → ℝ) (b₁ b₂ : ℝ)
    (hip₁ : ∑ i, (u i - b₁ * w₁ i - b₂ * w₂ i) * w₁ i * Var[Xs i; P] = 0)
    (hip₂ : ∑ i, (u i - b₁ * w₁ i - b₂ * w₂ i) * w₂ i * Var[Xs i; P] = 0) :
    P[lin Xs u | MeasurableSpace.comap (fun ω => (lin Xs w₁ ω, lin Xs w₂ ω)) inferInstance] =ᵐ[P]
      fun ω => b₁ * lin Xs w₁ ω + b₂ * lin Xs w₂ ω := by
  have hXY : HasGaussianLaw (fun ω => (lin Xs u ω, (lin Xs w₁ ω, lin Xs w₂ ω))) P := by
    have h := hG.map ((linCLM u).prod ((linCLM w₁).prod (linCLM w₂)))
    have e : (((linCLM u).prod ((linCLM w₁).prod (linCLM w₂))) ∘ fun ω => (Xs · ω)) =
        fun ω => (lin Xs u ω, (lin Xs w₁ ω, lin Xs w₂ ω)) := by
      funext ω; simp [linCLM_apply, lin]
    rwa [e] at h
  have hY : Measurable (fun ω => (lin Xs w₁ ω, lin Xs w₂ ω)) :=
    (lin_measurable hm w₁).prodMk (lin_measurable hm w₂)
  have := condExp_gaussian_regression (lin_measurable hm u) hY hXY
    (b₁ • ContinuousLinearMap.fst ℝ ℝ ℝ + b₂ • ContinuousLinearMap.snd ℝ ℝ ℝ) 0 ?_ ?_
  · filter_upwards [this] with ω hω
    rw [hω]; simp
  · simp only [add_apply, smul_apply,
      ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd', smul_eq_mul, lin_sub2]
    exact integral_lin hL2 h0 _
  · intro L₂
    simp only [add_apply, smul_apply,
      ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd', smul_eq_mul, lin_sub2]
    have e : (fun ω => L₂ (lin Xs w₁ ω, lin Xs w₂ ω)) =
        lin Xs (fun i => L₂ (1, 0) * w₁ i + L₂ (0, 1) * w₂ i) := by
      funext ω
      rw [← lin_add2]
      have : ((lin Xs w₁ ω, lin Xs w₂ ω) : ℝ × ℝ) =
          lin Xs w₁ ω • ((1 : ℝ), (0 : ℝ)) + lin Xs w₂ ω • ((0 : ℝ), (1 : ℝ)) := by simp
      rw [this, map_add, L₂.map_smul, L₂.map_smul, smul_eq_mul, smul_eq_mul]
      ring
    rw [e]
    have : (fun ω => lin Xs (fun i => u i - b₁ * w₁ i - b₂ * w₂ i) ω) =
      lin Xs (fun i => u i - b₁ * w₁ i - b₂ * w₂ i) := rfl
    rw [this, cov_lin hL2 hind]
    have : ∑ i, (u i - b₁ * w₁ i - b₂ * w₂ i) * (L₂ (1, 0) * w₁ i + L₂ (0, 1) * w₂ i) *
        Var[Xs i; P] = L₂ (1, 0) * ∑ i, (u i - b₁ * w₁ i - b₂ * w₂ i) * w₁ i * Var[Xs i; P] +
          L₂ (0, 1) * ∑ i, (u i - b₁ * w₁ i - b₂ * w₂ i) * w₂ i * Var[Xs i; P] := by
      rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun i _ => by ring
    rw [this, hip₁, hip₂]; ring

end Lin

end GaussReg

open GaussReg in
/-- **Proposition 4**, for measurable `θ, μ, ε, ν` (the model's random variables). -/
theorem prop4_of_measurable (θ μ ε ν : Ω → ℝ) (σθ2 σμ2 : ℝ≥0)
    (hθ : HasLaw θ (gaussianReal 0 σθ2) P) (hμ : HasLaw μ (gaussianReal 0 σμ2) P)
    (hε : HasLaw ε (gaussianReal 0 1) P) (hν : HasLaw ν (gaussianReal 0 1) P)
    (hind : iIndepFun ![θ, μ, ε, ν] P) (lamS lamV γ₂ : ℝ) (hS : 0 < lamS) (hV : 0 < lamV)
    (hmθ : Measurable θ) (hmμ : Measurable μ) (hmε : Measurable ε) (hmν : Measurable ν) :
    let a₁ : Ω → ℝ := fun ω => lamS * (θ ω + ε ω) + lamV * (μ ω + ν ω)
    let Eθ := P[θ | MeasurableSpace.comap a₁ inferInstance]
    let Eμ := P[μ | MeasurableSpace.comap a₁ inferInstance]
    let Eθ_μ := P[θ | MeasurableSpace.comap (fun ω => (a₁ ω, μ ω)) inferInstance]
    let Eμ_θ := P[μ | MeasurableSpace.comap (fun ω => (a₁ ω, θ ω)) inferInstance]
    let aStar : Ω → ℝ := fun ω => γ₂ * Eθ ω + Eμ ω
    ((fun ω => (γ₂ * Eθ_μ ω + μ ω) - aStar ω) =ᵐ[P] fun ω =>
        (1 - γ₂ * ((σθ2 : ℝ) * lamS * lamV / (lamV ^ 2 + lamS ^ 2 * ((σθ2 : ℝ) + 1)))) *
          (μ ω - Eμ ω)) ∧
    ((fun ω => (γ₂ * θ ω + Eμ_θ ω) - aStar ω) =ᵐ[P] fun ω =>
        (γ₂ - (σμ2 : ℝ) * lamS * lamV / (lamS ^ 2 + lamV ^ 2 * ((σμ2 : ℝ) + 1))) *
          (θ ω - Eθ ω)) := by
  intro a₁ Eθ Eμ Eθ_μ Eμ_θ aStar
  set Xs : Fin 4 → Ω → ℝ := ![θ, μ, ε, ν] with hXs
  have hlaw : ∀ i, HasLaw (Xs i) (gaussianReal 0 (![σθ2, σμ2, 1, 1] i)) P := by
    intro i; fin_cases i
    · simpa [Xs] using hθ
    · simpa [Xs] using hμ
    · simpa [Xs] using hε
    · simpa [Xs] using hν
  have hm : ∀ i, Measurable (Xs i) := by
    intro i; fin_cases i
    · simpa [Xs] using hmθ
    · simpa [Xs] using hmμ
    · simpa [Xs] using hmε
    · simpa [Xs] using hmν
  have hGi : ∀ i, HasGaussianLaw (Xs i) P := fun i => (hlaw i).hasGaussianLaw
  have hL2 : ∀ i, MemLp (Xs i) 2 P := fun i => (hGi i).memLp_two
  have h0 : ∀ i, ∫ ω, Xs i ω ∂P = 0 := fun i => by
    rw [(hlaw i).integral_eq, integral_id_gaussianReal]
  have hvar : ∀ i, Var[Xs i; P] = ((![σθ2, σμ2, 1, 1] i : ℝ≥0) : ℝ) := fun i => by
    rw [(hlaw i).variance_eq, variance_id_gaussianReal]
  have hG : HasGaussianLaw (fun ω => (Xs · ω)) P := iIndepFun.hasGaussianLaw hGi hind
  -- the variables as linear combinations of `(θ, μ, ε, ν)`
  set wθ : Fin 4 → ℝ := ![1, 0, 0, 0] with hwθ
  set wμ : Fin 4 → ℝ := ![0, 1, 0, 0] with hwμ
  set wa : Fin 4 → ℝ := ![lamS, lamV, lamS, lamV] with hwa
  have hθlin : lin Xs wθ = θ := by funext ω; simp [lin, Fin.sum_univ_four, Xs, wθ]
  have hμlin : lin Xs wμ = μ := by funext ω; simp [lin, Fin.sum_univ_four, Xs, wμ]
  have halin : lin Xs wa = a₁ := by
    funext ω; simp [lin, Fin.sum_univ_four, Xs, wa, a₁]; ring
  set sθ : ℝ := (σθ2 : ℝ) with hsθ
  set sμ : ℝ := (σμ2 : ℝ) with hsμ
  have hsθ0 : 0 ≤ sθ := NNReal.coe_nonneg _
  have hsμ0 : 0 ≤ sμ := NNReal.coe_nonneg _
  have hvar' : ∀ i, Var[Xs i; P] = ![sθ, sμ, 1, 1] i := fun i => by
    rw [hvar i]; fin_cases i <;> simp [sθ, sμ]
  -- `Var(a₁)` and the other denominators
  set V : ℝ := lamS ^ 2 * sθ + lamS ^ 2 + lamV ^ 2 * sμ + lamV ^ 2 with hVdef
  have hV0 : 0 < V := by positivity
  have hD1 : 0 < lamV ^ 2 + lamS ^ 2 * (sθ + 1) := by positivity
  have hD2 : 0 < lamS ^ 2 + lamV ^ 2 * (sμ + 1) := by positivity
  -- the four conditional expectations
  have hEθ : Eθ =ᵐ[P] fun ω => lamS * sθ / V * a₁ ω := by
    have := condExp_lin1 hm hL2 h0 hind hG wθ wa (lamS * sθ / V) (by
      simp only [Fin.sum_univ_four, hvar']
      simp [wθ, wa]
      field_simp; ring)
    rwa [hθlin, halin] at this
  have hEμ : Eμ =ᵐ[P] fun ω => lamV * sμ / V * a₁ ω := by
    have := condExp_lin1 hm hL2 h0 hind hG wμ wa (lamV * sμ / V) (by
      simp only [Fin.sum_univ_four, hvar']
      simp [wμ, wa]
      field_simp; ring)
    rwa [hμlin, halin] at this
  have hEθμ : Eθ_μ =ᵐ[P] fun ω => lamS * sθ / (lamV ^ 2 + lamS ^ 2 * (sθ + 1)) * a₁ ω +
      (-(lamS * sθ / (lamV ^ 2 + lamS ^ 2 * (sθ + 1))) * lamV) * μ ω := by
    have := condExp_lin2 hm hL2 h0 hind hG wθ wa wμ (lamS * sθ / (lamV ^ 2 + lamS ^ 2 * (sθ + 1)))
      (-(lamS * sθ / (lamV ^ 2 + lamS ^ 2 * (sθ + 1))) * lamV) (by
        simp only [Fin.sum_univ_four, hvar']
        simp [wθ, wa, wμ]
        field_simp; ring) (by
        simp only [Fin.sum_univ_four, hvar']
        simp [wθ, wa, wμ])
    rwa [hθlin, halin, hμlin] at this
  have hEμθ : Eμ_θ =ᵐ[P] fun ω => lamV * sμ / (lamS ^ 2 + lamV ^ 2 * (sμ + 1)) * a₁ ω +
      (-(lamV * sμ / (lamS ^ 2 + lamV ^ 2 * (sμ + 1))) * lamS) * θ ω := by
    have := condExp_lin2 hm hL2 h0 hind hG wμ wa wθ (lamV * sμ / (lamS ^ 2 + lamV ^ 2 * (sμ + 1)))
      (-(lamV * sμ / (lamS ^ 2 + lamV ^ 2 * (sμ + 1))) * lamS) (by
        simp only [Fin.sum_univ_four, hvar']
        simp [wθ, wa, wμ]
        field_simp; ring) (by
        simp only [Fin.sum_univ_four, hvar']
        simp [wθ, wa, wμ])
    rwa [hμlin, halin, hθlin] at this
  constructor
  · filter_upwards [hEθ, hEμ, hEθμ] with ω h1 h2 h3
    simp only [aStar]
    rw [h1, h2, h3]
    field_simp
    ring
  · filter_upwards [hEθ, hEμ, hEμθ] with ω h1 h2 h3
    simp only [aStar]
    rw [h1, h2, h3]
    field_simp
    ring

/-- **Proposition 4.** With `Δ(μ)` (resp. `Δ(θ)`) the change in the pooling decision after a
peer-oriented (resp. individual-oriented) intervention that reveals `μ` (resp. `θ`),
`Δ(μ) = (1 - γ₂ σ²_θ λ_s λ_v / (λ_v² + λ_s² (σ²_θ + 1))) (μ - E(μ | a₁))` and
`Δ(θ) = (γ₂ - σ²_μ λ_s λ_v / (λ_s² + λ_v² (σ²_μ + 1))) (θ - E(θ | a₁))`. -/
theorem prop4 (θ μ ε ν : Ω → ℝ) (σθ2 σμ2 : ℝ≥0)
    (hθ : HasLaw θ (gaussianReal 0 σθ2) P) (hμ : HasLaw μ (gaussianReal 0 σμ2) P)
    (hε : HasLaw ε (gaussianReal 0 1) P) (hν : HasLaw ν (gaussianReal 0 1) P)
    (hind : iIndepFun ![θ, μ, ε, ν] P) (lamS lamV γ₂ : ℝ) (hS : 0 < lamS) (hV : 0 < lamV)
    (hmθ : Measurable θ) (hmμ : Measurable μ) (hmε : Measurable ε) (hmν : Measurable ν) :
    let a₁ : Ω → ℝ := fun ω => lamS * (θ ω + ε ω) + lamV * (μ ω + ν ω)
    let Eθ := P[θ | MeasurableSpace.comap a₁ inferInstance]
    let Eμ := P[μ | MeasurableSpace.comap a₁ inferInstance]
    let Eθ_μ := P[θ | MeasurableSpace.comap (fun ω => (a₁ ω, μ ω)) inferInstance]
    let Eμ_θ := P[μ | MeasurableSpace.comap (fun ω => (a₁ ω, θ ω)) inferInstance]
    let aStar : Ω → ℝ := fun ω => γ₂ * Eθ ω + Eμ ω
    ((fun ω => (γ₂ * Eθ_μ ω + μ ω) - aStar ω) =ᵐ[P] fun ω =>
        (1 - γ₂ * ((σθ2 : ℝ) * lamS * lamV / (lamV ^ 2 + lamS ^ 2 * ((σθ2 : ℝ) + 1)))) *
          (μ ω - Eμ ω)) ∧
    ((fun ω => (γ₂ * θ ω + Eμ_θ ω) - aStar ω) =ᵐ[P] fun ω =>
        (γ₂ - (σμ2 : ℝ) * lamS * lamV / (lamS ^ 2 + lamV ^ 2 * ((σμ2 : ℝ) + 1))) *
          (θ ω - Eθ ω)) := by
  exact prop4_of_measurable θ μ ε ν σθ2 σμ2 hθ hμ hε hν hind lamS lamV γ₂ hS hV hmθ hmμ hmε hmν

end CC
