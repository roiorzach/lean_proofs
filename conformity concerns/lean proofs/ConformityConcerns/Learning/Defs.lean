import ConformityConcerns.Basic
import Mathlib.Probability.ProductMeasure
import Mathlib.Probability.ConditionalExpectation
import Mathlib.MeasureTheory.Function.ConvergenceInMeasure
import Mathlib.MeasureTheory.Constructions.Pi

/-!
# Learning peers' preferences across histories (θ known; Propositions A4 and A6)

Probability space: `ω = (μ, (ν_t)_t)` with `μ ~ Lμ` and `ν_t` i.i.d. `~ Lν`, independent;
player `t`'s type is `v_t = μ + ν_t`.

A (pure) dynamic strategy profile `c t h v` gives player `t`'s action as a function of the public
history `h` of the `t` previous actions and of `v_t`; `histVec c t ω` is the realised history and
`play c t ω` the realised action. The public posterior mean `μ(h^t) = E(μ | h^t)` is Mathlib's
conditional expectation of `μ` given the σ-algebra generated by the history.

Social learning about preferences (the paper's definition): for almost every realisation `m` of
`μ`, `μ(h^t) → m` in probability conditional on `μ = m` (i.e. under the law of the noise
sequence); it fails if for almost every `m` this convergence fails.
-/

namespace CC.Learning

open MeasureTheory ProbabilityTheory Filter Topology

set_option warn.classDefReducibility false

/-- The sample space `(μ, (ν_t)_t)`. -/
abbrev Ω := ℝ × (ℕ → ℝ)

/-- The law of `(μ, (ν_t)_t)`. -/
noncomputable def law (Lμ Lν : Measure ℝ) : Measure Ω :=
  Lμ.prod (Measure.infinitePi fun _ : ℕ => Lν)

/-- The average preference `μ`. -/
def muV (ω : Ω) : ℝ := ω.1

/-- Player `t`'s preference type `v_t = μ + ν_t`. -/
def vt (t : ℕ) (ω : Ω) : ℝ := ω.1 + ω.2 t

/-- A pure dynamic strategy profile: `c t h v` is player `t`'s action after history `h` with type
`v`. -/
abbrev Profile := ∀ t : ℕ, (Fin t → ℝ) → ℝ → ℝ

/-- The realised public history (the first `t` actions). -/
def histVec (c : Profile) : (t : ℕ) → Ω → (Fin t → ℝ)
  | 0 => fun _ => Fin.elim0
  | t + 1 => fun ω => Fin.snoc (histVec c t ω) (c t (histVec c t ω) (vt t ω))

/-- The realised action of player `t`. -/
def play (c : Profile) (t : ℕ) (ω : Ω) : ℝ := c t (histVec c t ω) (vt t ω)

/-- The σ-algebra generated by the public history `h^t`. -/
def histSigma (act : ℕ → Ω → ℝ) (t : ℕ) : MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω (i : Fin t) => act i ω) inferInstance

/-- The public posterior mean `μ(h^t) = E(μ | h^t)`. -/
noncomputable def postMean (P : Measure Ω) (act : ℕ → Ω → ℝ) (t : ℕ) : Ω → ℝ :=
  P[muV | histSigma act t]

/-- Social learning about preferences occurs (paper's definition). -/
def SocialLearningOccurs (Lμ Lν : Measure ℝ) (post : ℕ → Ω → ℝ) : Prop :=
  ∀ᵐ m ∂Lμ, TendstoInMeasure (Measure.infinitePi fun _ : ℕ => Lν)
    (fun t n => post t (m, n)) atTop (fun _ => m)

/-- Social learning about preferences fails (paper's definition). -/
def SocialLearningFails (Lμ Lν : Measure ℝ) (post : ℕ → Ω → ℝ) : Prop :=
  ∀ᵐ m ∂Lμ, ¬ TendstoInMeasure (Measure.infinitePi fun _ : ℕ => Lν)
    (fun t n => post t (m, n)) atTop (fun _ => m)

/-- The revealing profile built from a shape `Φ`, with norm given by a version `post` of the
public posterior mean: `a_t = μ(h^t) + Φ(v_t - μ(h^t))`. Here `post t` is any function of the
realised history. -/
def revealAct (Φ : ℝ → ℝ) (post : ℕ → Ω → ℝ) (t : ℕ) (ω : Ω) : ℝ :=
  post t ω + Φ (vt t ω - post t ω)

/-- `σ(v_0, …, v_{t-1})`. -/
def typeSigma (t : ℕ) : MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω (i : Fin t) => vt i ω) inferInstance

end CC.Learning
