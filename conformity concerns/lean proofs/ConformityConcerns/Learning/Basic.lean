import ConformityConcerns.Learning.Defs
import Mathlib.Probability.StrongLaw
import Mathlib.Probability.Martingale.Convergence
import Mathlib.Probability.Independence.InfinitePi

/-!
# Learning when every period reveals, and no learning when every period pools
-/

namespace CC.Learning

open MeasureTheory ProbabilityTheory Filter Topology

instance law_isProb (Lμ Lν : Measure ℝ) [IsProbabilityMeasure Lμ] [IsProbabilityMeasure Lν] :
    IsProbabilityMeasure (law Lμ Lν) := by
  unfold law; infer_instance

/-! ### Measurability -/

lemma measurable_muV : Measurable muV := measurable_fst

lemma measurable_vt (t : ℕ) : Measurable (vt t) :=
  measurable_fst.add ((measurable_pi_apply t).comp measurable_snd)

/-- A coordinate `i < t` is measurable for the σ-algebra generated by the first `t` coordinates. -/
lemma measurable_coord {X : ℕ → Ω → ℝ} {t i : ℕ} (hi : i < t) :
    Measurable[MeasurableSpace.comap (fun ω (j : Fin t) => X j ω) inferInstance] (X i) := by
  have h1 : Measurable (fun f : Fin t → ℝ => f ⟨i, hi⟩) := measurable_pi_apply _
  exact h1.comp (comap_measurable (fun ω (j : Fin t) => X j ω))

lemma comap_le_of_coord {X : ℕ → Ω → ℝ} {t : ℕ} {m : MeasurableSpace Ω}
    (h : ∀ i, i < t → Measurable[m] (X i)) :
    MeasurableSpace.comap (fun ω (j : Fin t) => X j ω) inferInstance ≤ m :=
  Measurable.comap_le (measurable_pi_iff.2 fun j => h j j.isLt)

lemma typeSigma_le (t : ℕ) : typeSigma t ≤ (inferInstance : MeasurableSpace Ω) :=
  comap_le_of_coord fun i _ => measurable_vt i

lemma typeSigma_mono : Monotone typeSigma := fun _ _ hst =>
  comap_le_of_coord fun _ hi => measurable_coord (X := vt) (lt_of_lt_of_le hi hst)

/-- The filtration `σ(v_0, …, v_{t-1})`. -/
noncomputable def typeFiltration : Filtration ℕ (inferInstance : MeasurableSpace Ω) :=
  ⟨typeSigma, typeSigma_mono, typeSigma_le⟩

/-! ### The revealing profile: the history generates the types -/

section Reveal

variable (Lμ Lν : Measure ℝ) [IsProbabilityMeasure Lμ] [IsProbabilityMeasure Lν]

omit [IsProbabilityMeasure Lμ] [IsProbabilityMeasure Lν] in
lemma hist_eq_type (Φ : ℝ → ℝ) (hΦ : StrictMono Φ) (hΦc : Continuous Φ) (t : ℕ) :
    histSigma (revealAct Φ (fun t => (law Lμ Lν)[muV | typeSigma t])) t = typeSigma t := by
  set post : ℕ → Ω → ℝ := fun t => (law Lμ Lν)[muV | typeSigma t] with hpostdef
  set act := revealAct Φ post with hactdef
  have hpost : ∀ t, Measurable[typeSigma t] (post t) := fun t =>
    stronglyMeasurable_condExp.measurable
  have hact : ∀ i t, i < t → Measurable[typeSigma t] (act i) := by
    intro i t hit
    have h1 : Measurable[typeSigma t] (post i) := (hpost i).mono (typeSigma_mono hit.le) le_rfl
    have h2 : Measurable[typeSigma t] (vt i) := measurable_coord (X := vt) hit
    exact h1.add (hΦc.measurable.comp (h2.sub h1))
  have hle : ∀ t, histSigma act t ≤ typeSigma t := fun t =>
    comap_le_of_coord (fun i hi => hact i t hi)
  have hmono : ∀ t, histSigma act t ≤ histSigma act (t + 1) := fun t =>
    comap_le_of_coord fun i hi => measurable_coord (X := act) (Nat.lt_succ_of_lt hi)
  have hge : ∀ t, typeSigma t ≤ histSigma act t := by
    intro t
    induction t with
    | zero => exact comap_le_of_coord fun i hi => absurd hi (Nat.not_lt_zero i)
    | succ t ih =>
      refine comap_le_of_coord fun i hi => ?_
      rcases lt_or_eq_of_le (Nat.lt_succ_iff.1 hi) with hi | hi
      · exact ((measurable_coord (X := vt) hi).mono ih le_rfl).mono (hmono t) le_rfl
      · subst hi
        have hp : Measurable[histSigma act (i + 1)] (post i) :=
          ((hpost i).mono ih le_rfl).mono (hmono i) le_rfl
        have ha : Measurable[histSigma act (i + 1)] (act i) :=
          measurable_coord (X := act) (Nat.lt_succ_self i)
        have hΦm : Measurable[histSigma act (i + 1)] (fun ω => Φ (vt i ω - post i ω)) := by
          have : (fun ω => Φ (vt i ω - post i ω)) = fun ω => act i ω - post i ω := by
            funext ω; simp only [hactdef, revealAct]; ring
          rw [this]; exact ha.sub hp
        have hd : Measurable[histSigma act (i + 1)] (fun ω => vt i ω - post i ω) := by
          refine measurable_of_Iio fun q => ?_
          have : (fun ω => vt i ω - post i ω) ⁻¹' Set.Iio q =
              (fun ω => Φ (vt i ω - post i ω)) ⁻¹' Set.Iio (Φ q) := by
            ext ω; simp [hΦ.lt_iff_lt]
          rw [this]; exact hΦm measurableSet_Iio
        have : vt i = fun ω => (vt i ω - post i ω) + post i ω := by funext ω; ring
        rw [this]; exact hd.add hp
  exact le_antisymm (hle t) (hge t)

/-- Strong law for the noise sequence. -/
lemma ae_tendsto_avg_noise (hν : Integrable id Lν) (hν0 : ∫ x, x ∂Lν = 0) :
    ∀ᵐ n ∂(Measure.infinitePi fun _ : ℕ => Lν),
      Tendsto (fun k : ℕ => (k : ℝ)⁻¹ • ∑ i ∈ Finset.range k, n i) atTop (𝓝 0) := by
  set Q := Measure.infinitePi fun _ : ℕ => Lν with hQ
  have hmap : ∀ i, Q.map (fun n : ℕ → ℝ => n i) = Lν := fun i =>
    Measure.infinitePi_map_eval (fun _ : ℕ => Lν) i
  have hint : Integrable (fun n : ℕ → ℝ => n 0) Q := by
    have : Integrable id (Q.map (fun n : ℕ → ℝ => n 0)) := by rw [hmap]; exact hν
    exact this.comp_measurable (measurable_pi_apply 0)
  have hind : Pairwise (Function.onFun (fun f g => IndepFun f g Q)
      (fun i (n : ℕ → ℝ) => n i)) := by
    intro i j hij
    exact (iIndepFun_infinitePi (P := fun _ : ℕ => Lν) (X := fun _ x => x)
      (fun _ => measurable_id)).indepFun hij
  have hident : ∀ i, IdentDistrib (fun n : ℕ → ℝ => n i) (fun n => n 0) Q Q := fun i =>
    ⟨(measurable_pi_apply i).aemeasurable, (measurable_pi_apply 0).aemeasurable, by
      rw [hmap, hmap]⟩
  have hsl := strong_law_ae (fun i (n : ℕ → ℝ) => n i) hint hind hident
  have hmean : ∫ n, n 0 ∂Q = 0 := by
    have h := integral_map (μ := Q) (φ := fun n : ℕ → ℝ => n 0)
      (measurable_pi_apply 0).aemeasurable (f := id) aestronglyMeasurable_id
    rw [hmap] at h
    exact h.symm.trans hν0
  filter_upwards [hsl] with n hn
  convert hn using 2
  exact hmean.symm

omit [IsProbabilityMeasure Lμ] in
/-- Strong law for the types: the sample mean of `v_0, …, v_{k-1}` converges to `μ`. -/
lemma ae_tendsto_avg (hν : Integrable id Lν) (hν0 : ∫ x, x ∂Lν = 0) :
    ∀ᵐ ω ∂(law Lμ Lν),
      Tendsto (fun k : ℕ => (k : ℝ)⁻¹ * ∑ i ∈ Finset.range k, vt i ω) atTop (𝓝 (muV ω)) := by
  have h := (Measure.quasiMeasurePreserving_snd (μ := Lμ)
    (ν := Measure.infinitePi fun _ : ℕ => Lν)).ae (ae_tendsto_avg_noise Lν hν hν0)
  unfold law
  filter_upwards [h] with ω hω
  have hω' := hω.const_add ω.1
  rw [add_zero] at hω'
  refine hω'.congr' ?_
  filter_upwards [eventually_ge_atTop 1] with k hk
  have hk' : (k : ℝ) ≠ 0 := by positivity
  simp only [vt, Finset.sum_add_distrib, Finset.sum_const, Finset.card_range, smul_eq_mul,
    nsmul_eq_mul]
  rw [mul_add, ← mul_assoc, inv_mul_cancel₀ hk', one_mul]

omit [IsProbabilityMeasure Lμ] in
lemma integrable_muV (hμ : Integrable id Lμ) : Integrable muV (law Lμ Lν) := by
  have hmap : (law Lμ Lν).map Prod.fst = Lμ := by
    unfold law; rw [Measure.map_fst_prod, measure_univ, one_smul]
  have : Integrable id ((law Lμ Lν).map Prod.fst) := by rw [hmap]; exact hμ
  exact this.comp_measurable measurable_fst

/-- Lévy's upward theorem plus the strong law: the posterior given the types converges to `μ`. -/
lemma post_tendsto (hμ : Integrable id Lμ) (hν : Integrable id Lν) (hν0 : ∫ x, x ∂Lν = 0) :
    ∀ᵐ ω ∂(law Lμ Lν),
      Tendsto (fun t => (law Lμ Lν)[muV | typeSigma t] ω) atTop (𝓝 (muV ω)) := by
  set P := law Lμ Lν with hP
  have hint : Integrable muV P := integrable_muV Lμ Lν hμ
  set ℱ := typeFiltration
  set avg : ℕ → Ω → ℝ := fun k ω => (k : ℝ)⁻¹ * ∑ i ∈ Finset.range k, vt i ω with havgdef
  have havg : ∀ k, Measurable[⨆ n, ℱ n] (avg k) := by
    intro k
    have : Measurable[typeSigma k] (avg k) :=
      measurable_const.mul (Finset.measurable_sum _ (fun i hi =>
        measurable_coord (X := vt) (Finset.mem_range.1 hi)))
    exact this.mono (le_iSup (fun n => ℱ n) k) le_rfl
  set g' : Ω → ℝ := fun ω => limsup (fun k => avg k ω) atTop with hg'def
  have hg'm : Measurable[⨆ n, ℱ n] g' := Measurable.limsup havg
  have hg'eq : g' =ᵐ[P] muV := by
    filter_upwards [ae_tendsto_avg Lμ Lν hν hν0] with ω hω
    exact hω.limsup_eq
  have hg'int : Integrable g' P := hint.congr hg'eq.symm
  have hlevy := hg'int.tendsto_ae_condExp (ℱ := ℱ) hg'm.stronglyMeasurable
  have hce : ∀ᵐ ω ∂P, ∀ n, P[g' | typeSigma n] ω = P[muV | typeSigma n] ω :=
    ae_all_iff.2 fun n => condExp_congr_ae hg'eq
  filter_upwards [hlevy, hce, hg'eq] with ω h1 h2 h3
  rw [h3] at h1
  exact h1.congr h2

omit [IsProbabilityMeasure Lμ] in
lemma learning_occurs_of_ae (post : ℕ → Ω → ℝ) (hm : ∀ t, Measurable (post t))
    (h : ∀ᵐ ω ∂(law Lμ Lν), Tendsto (fun t => post t ω) atTop (𝓝 (muV ω))) :
    SocialLearningOccurs Lμ Lν post := by
  unfold law at h
  have h' := Measure.ae_ae_of_ae_prod h
  filter_upwards [h'] with m hm'
  exact tendstoInMeasure_of_tendsto_ae
    (fun t => ((hm t).comp measurable_prodMk_left).aestronglyMeasurable) hm'

end Reveal

/-- If every period plays the revealing rule `a_t = μ(h^t) + Φ(v_t - μ(h^t))` (with `Φ` strictly
increasing and continuous), where `μ(h^t)` is the posterior mean given `σ(v_0,…,v_{t-1})`, then
the public history generates exactly `σ(v_0,…,v_{t-1})` — so this `μ(h^t)` is the posterior mean
given the history of actions — and `μ(h^t) → μ` almost surely; social learning about preferences
occurs. -/
theorem learning_revealing (Lμ Lν : Measure ℝ) [IsProbabilityMeasure Lμ] [IsProbabilityMeasure Lν]
    (hμ : Integrable id Lμ) (hν : Integrable id Lν) (hν0 : ∫ x, x ∂Lν = 0)
    (Φ : ℝ → ℝ) (hΦ : StrictMono Φ) (hΦc : Continuous Φ) :
    let P := law Lμ Lν
    let post : ℕ → Ω → ℝ := fun t => P[muV | typeSigma t]
    let act := revealAct Φ post
    (∀ t, histSigma act t = typeSigma t) ∧
    (∀ t, postMean P act t = post t) ∧
    (∀ᵐ ω ∂P, Tendsto (fun t => postMean P act t ω) atTop (𝓝 (muV ω))) ∧
    SocialLearningOccurs Lμ Lν (postMean P act) := by
  intro P post act
  have h1 : ∀ t, histSigma act t = typeSigma t := hist_eq_type Lμ Lν Φ hΦ hΦc
  have h2 : ∀ t, postMean P act t = post t := fun t => by
    show P[muV | histSigma act t] = P[muV | typeSigma t]
    rw [h1 t]
  have hpe : postMean P act = post := funext h2
  have hconv : ∀ᵐ ω ∂P, Tendsto (fun t => post t ω) atTop (𝓝 (muV ω)) :=
    post_tendsto Lμ Lν hμ hν hν0
  refine ⟨h1, h2, ?_, ?_⟩
  · rw [hpe]; exact hconv
  · rw [hpe]
    exact learning_occurs_of_ae Lμ Lν post
      (fun t => (stronglyMeasurable_condExp.measurable).mono (typeSigma_le t) le_rfl) hconv

/-! ### The pooling profile -/

lemma histVec_const (c : Profile) (hpool : ∀ t (h : Fin t → ℝ) (v w : ℝ), c t h v = c t h w) :
    ∀ t, ∃ H : Fin t → ℝ, ∀ ω, histVec c t ω = H := by
  intro t
  induction t with
  | zero => exact ⟨Fin.elim0, fun ω => rfl⟩
  | succ t ih =>
    obtain ⟨H, hH⟩ := ih
    refine ⟨Fin.snoc (α := fun _ => ℝ) H (c t H 0), fun ω => ?_⟩
    have e : histVec c (t + 1) ω =
        Fin.snoc (α := fun _ => ℝ) (histVec c t ω) (c t (histVec c t ω) (vt t ω)) := rfl
    rw [e, hH ω, hpool t H (vt t ω) 0]

lemma histSigma_play_bot (c : Profile)
    (hpool : ∀ t (h : Fin t → ℝ) (v w : ℝ), c t h v = c t h w) (t : ℕ) :
    histSigma (play c) t = ⊥ := by
  have hK : ∃ K : Fin t → ℝ, ∀ ω, (fun (i : Fin t) => play c i ω) = K := by
    refine ⟨fun i => c i (Classical.choose (histVec_const c hpool i)) 0,
      fun ω => funext fun i => ?_⟩
    unfold play
    rw [Classical.choose_spec (histVec_const c hpool i) ω, hpool]
  obtain ⟨K, hK⟩ := hK
  unfold histSigma
  have : (fun ω (i : Fin t) => play c i ω) = fun _ => K := funext hK
  rw [this, MeasurableSpace.comap_const]

/-- If every period is pooling at every history (each action is a function of the public history
only), the public history is uninformative: `μ(h^t) = E μ` almost surely, and since `μ` is
atomless, social learning about preferences fails. -/
theorem learning_pooling (Lμ Lν : Measure ℝ) [IsProbabilityMeasure Lμ] [IsProbabilityMeasure Lν]
    (_hμ : Integrable id Lμ) (hatom : ∀ x, Lμ {x} = 0) (c : Profile)
    (hpool : ∀ t (h : Fin t → ℝ) (v w : ℝ), c t h v = c t h w) :
    let P := law Lμ Lν
    (∀ t, ∀ᵐ ω ∂P, postMean P (play c) t ω = ∫ x, x ∂Lμ) ∧
    SocialLearningFails Lμ Lν (postMean P (play c)) := by
  intro P
  have hint : ∫ ω, muV ω ∂P = ∫ x, x ∂Lμ := by
    have hmap : P.map Prod.fst = Lμ := by
      show (law Lμ Lν).map Prod.fst = Lμ
      unfold law; rw [Measure.map_fst_prod, measure_univ, one_smul]
    rw [← hmap, integral_map (f := fun x : ℝ => x) measurable_fst.aemeasurable
      aestronglyMeasurable_id]
    rfl
  have hpm : ∀ t, postMean P (play c) t = fun _ => ∫ x, x ∂Lμ := by
    intro t
    unfold postMean
    rw [histSigma_play_bot c hpool t, condExp_bot, hint]
  refine ⟨fun t => Eventually.of_forall fun ω => by rw [hpm t], ?_⟩
  have hne : ∀ᵐ m ∂Lμ, m ≠ ∫ x, x ∂Lμ := by
    rw [ae_iff]
    simpa using hatom (∫ x, x ∂Lμ)
  filter_upwards [hne] with m hm hT
  have hε : 0 < edist (∫ x, x ∂Lμ) m := edist_pos.2 (Ne.symm hm)
  have := hT _ hε
  simp only [hpm, le_refl, Set.ofPred_true, measure_univ] at this
  exact one_ne_zero (tendsto_nhds_unique tendsto_const_nhds this)

end CC.Learning
