import ConformityConcerns.Dynamics.Defs
import Mathlib.Probability.Distributions.Gaussian.Multivariate
import Mathlib.Probability.Kernel.CondDistrib
import Mathlib.Probability.ConditionalExpectation
import Mathlib.MeasureTheory.Function.ConvergenceInMeasure

/-!
# Social learning in the Gaussian model, with the paper's definition

The primitives of Section 2 on one probability space: `(θ, μ) ~ N(0, Σ₁)`, `(ε_t, ν_t)` i.i.d.
`N(0, I)`, `γ_t` i.i.d. `~ G`, all independent. Player `t`'s private information is
`(s_t, v_t) = (θ, μ) + (ε_t, ν_t)`.

In the signaling equilibrium, `Σ_t` (`Sig`) is the covariance process along the realised weights
and a date is revealing iff `κ s̃(h^t)² ≤ κck` (Corollary 1). At a revealing date the action is
`a_t = E(Z_t | h^t) + λ_t (Z_t - E(Z_t | h^t))` with `λ_t = (1 + √(1 - 4κ s̃²))/2`, where
`E(Z_t | h^t) = γ_t θ(h^t) + μ(h^t)` and `Z_t - E(Z_t | h^t) = A_t · ((s_t, v_t) - (θ(h^t), μ(h^t)))`;
at a pooling date `a_t = γ_t θ(h^t) + μ(h^t)` (`signalingEq_char`). The public history is
`h^t = (γ_0, a_0, …, γ_{t-1}, a_{t-1}, γ_t)`.

`obs t = A_t · (s_t, v_t)` at revealing dates (`0` otherwise) is the informative part of `a_t`;
`infoSigma t` is generated by the weights and these observations, and posterior means are
conditional expectations given it. `histSigma t`, generated by the weights and the equilibrium
actions, is the σ-algebra of the public history.

Social learning about `θ` occurs if for almost every realisation `r` of `θ`, `θ(h^t) → r` in
probability under the conditional law given `θ = r` (`condDistrib`), and fails if for almost every
`r` this convergence fails; likewise for `μ`.
-/

namespace CC.Bridge

open MeasureTheory ProbabilityTheory Filter Topology

set_option warn.classDefReducibility false

/-- `ℝ²`. -/
abbrev E2 := EuclideanSpace ℝ (Fin 2)

/-- Sample space `((θ, μ), ((ε_t, ν_t))_t, (γ_t)_t)`. -/
abbrev Ωg := E2 × ((ℕ → E2) × (ℕ → ℝ))

/-- The law of the primitives. -/
noncomputable def lawG (S₁ : M2) (G : Measure ℝ) : Measure Ωg :=
  (multivariateGaussian 0 S₁).prod
    ((Measure.infinitePi fun _ : ℕ => stdGaussian E2).prod (Measure.infinitePi fun _ : ℕ => G))

instance (S₁ : M2) (G : Measure ℝ) [IsProbabilityMeasure G] : IsProbabilityMeasure (lawG S₁ G) := by
  unfold lawG; infer_instance

/-- The fundamental state `θ`. -/
def thetaV (ω : Ωg) : ℝ := ω.1 0

/-- The average preference `μ`. -/
def muV (ω : Ωg) : ℝ := ω.1 1

/-- The realised weights `(γ_t)_t`. -/
def gam (ω : Ωg) : ℕ → ℝ := ω.2.2

/-- Player `t`'s private information `(s_t, v_t) = (θ, μ) + (ε_t, ν_t)`. -/
def priv (t : ℕ) (ω : Ωg) : E2 := ω.1 + ω.2.1 t

/-- The posterior covariance process along the realised weights. -/
noncomputable def Sig (κ : ℝ) (S₁ : M2) (ω : Ωg) : ℕ → M2 := SigmaC (fun _ => κ) S₁ (gam ω)

/-- Date `t` is revealing. -/
def rev (κ : ℝ) (S₁ : M2) (t : ℕ) (ω : Ωg) : Prop := revCrit κ (Sig κ S₁ ω t) (gam ω t)

/-- The informative part of the period-`t` action: `A_t · (s_t, v_t)` if revealing, else `0`. -/
noncomputable def obs (κ : ℝ) (S₁ : M2) (t : ℕ) (ω : Ωg) : ℝ :=
  haveI := Classical.propDecidable (rev κ S₁ t ω)
  if rev κ S₁ t ω then
    loadA (Sig κ S₁ ω t) (gam ω t) 0 * priv t ω 0 + loadA (Sig κ S₁ ω t) (gam ω t) 1 * priv t ω 1
  else 0

/-- σ-algebra generated by `γ_0, …, γ_t` and the observations at dates `< t`. -/
noncomputable def infoSigma (κ : ℝ) (S₁ : M2) (t : ℕ) : MeasurableSpace Ωg :=
  MeasurableSpace.comap
    (fun ω => ((fun i : Fin (t + 1) => gam ω i), (fun i : Fin t => obs κ S₁ i ω))) inferInstance

/-- Posterior mean `θ(h^t)`. -/
noncomputable def postTheta (κ : ℝ) (S₁ : M2) (G : Measure ℝ) (t : ℕ) : Ωg → ℝ :=
  (lawG S₁ G)[thetaV | infoSigma κ S₁ t]

/-- Posterior mean `μ(h^t)`. -/
noncomputable def postMu (κ : ℝ) (S₁ : M2) (G : Measure ℝ) (t : ℕ) : Ωg → ℝ :=
  (lawG S₁ G)[muV | infoSigma κ S₁ t]

/-- The equilibrium action `a_t`. -/
noncomputable def eqAct (κ : ℝ) (S₁ : M2) (G : Measure ℝ) (t : ℕ) (ω : Ωg) : ℝ :=
  haveI := Classical.propDecidable (rev κ S₁ t ω)
  let S := Sig κ S₁ ω t
  let γ := gam ω t
  let mθ := postTheta κ S₁ G t ω
  let mμ := postMu κ S₁ G t ω
  if rev κ S₁ t ω then
    γ * mθ + mμ + (1 + √(1 - 4 * κ * sens S γ ^ 2)) / 2 *
      (obs κ S₁ t ω - (loadA S γ 0 * mθ + loadA S γ 1 * mμ))
  else γ * mθ + mμ

/-- σ-algebra of the public history `h^t = (γ_0, a_0, …, a_{t-1}, γ_t)`. -/
noncomputable def histSigma (κ : ℝ) (S₁ : M2) (G : Measure ℝ) (t : ℕ) : MeasurableSpace Ωg :=
  MeasurableSpace.comap
    (fun ω => ((fun i : Fin (t + 1) => gam ω i), (fun i : Fin t => eqAct κ S₁ G i ω)))
    inferInstance

/-- Social learning about `X` (`θ` or `μ`) occurs: for almost every realisation `r` of `X`, the
posterior mean converges in probability to `r` conditionally on `X = r`. -/
def SLOccurs (P : Measure Ωg) [IsFiniteMeasure P] (X : Ωg → ℝ) (post : ℕ → Ωg → ℝ) : Prop :=
  ∀ᵐ r ∂(P.map X), TendstoInMeasure (condDistrib id X P r) post atTop (fun _ => r)

/-- Social learning about `X` fails: for almost every realisation `r` of `X`, the posterior mean
does not converge in probability to `r` conditionally on `X = r`. -/
def SLFails (P : Measure Ωg) [IsFiniteMeasure P] (X : Ωg → ℝ) (post : ℕ → Ωg → ℝ) : Prop :=
  ∀ᵐ r ∂(P.map X), ¬ TendstoInMeasure (condDistrib id X P r) post atTop (fun _ => r)

end CC.Bridge
