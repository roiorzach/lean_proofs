import ConformityConcerns.LearnTheta.Select
import ConformityConcerns.LearnTheta.SocialLearning
import ConformityConcerns.LearnTheta.MVersion
import ConformityConcerns.LearnTheta.ExAux.Profile
import ConformityConcerns.LearnTheta.ExAux.Setting

/-!
# Proposition A5, `κ ≤ κck`: an equilibrium fully revealing at every history, with learning

"Moreover, if `κ ≤ κck`, there exists an equilibrium that satisfies `D1^∞` and is fully revealing
at every history, and social learning about fundamentals occurs in this equilibrium."

The paper assumes that at every history `h^t`, `m(· | h^t)` is `C²` with `0 < m'' ≤ 2`. Histories
are generated by a strategy profile, so the hypothesis `hm` states this at almost every realized
history of every measurable profile that has been fully revealing before date `t`; these are the
histories that a fully revealing equilibrium reaches. (With Gaussian primitives the beliefs at such
histories are Gaussian and `m` is quadratic with `0 < m'' ≤ 2`.) The period game at `h^t` has the conditional law of `ṽ_t`
given `h^t` (`typeLaw`) as type distribution, quadratic adaptation loss, and conformity loss
`κ (m(· | h^t) - min m(· | h^t))`.
-/

namespace CC.LearnTheta

open MeasureTheory ProbabilityTheory Filter Topology
open CC.General

variable (Lθ Lε : Measure ℝ) (ψ : ℝ → ℝ) [IsProbabilityMeasure Lθ] [IsProbabilityMeasure Lε]
  [IsProbabilityMeasure (vLaw ψ)]

/-- **Proposition A5, `κ ≤ κck`.** There is a measurable strategy profile that, at almost every
realized history, is a fully revealing equilibrium satisfying `D1^∞` of the period game at that
history; in it, social learning about fundamentals occurs (paper's definition). -/
theorem propA5_exists (κ : ℝ) (hκ0 : 0 < κ) (hκ : κ ≤ κck)
    (hθ : Integrable (fun x => x ^ 2) Lθ) (hψc : Continuous ψ) (hψpos : ∀ x, 0 < ψ x)
    (hψb : ∃ C, ∀ x, ψ x ≤ C) (hv2 : Integrable (fun x => x ^ 2) (vLaw ψ))
    (hsymm : ∀ x, ψ (-x) = ψ x) (h3 : Integrable (fun x => |x| ^ 3) (vLaw ψ))
    (P : Measure Ω) [IsProbabilityMeasure P] (hP : P = law Lθ Lε (vLaw ψ))
    (hm : ∀ c : Profile, (∀ t, Measurable (Function.uncurry (c t))) → ∀ t,
      (∀ s, s < t → ∀ᵐ ω ∂P, StrictMono (c s (hist P c s ω))) → ∀ᵐ ω ∂P,
      ContDiff ℝ 2 (mfun ψ (beliefY P c t (hist P c t ω))) ∧
      ∀ x, 0 < iteratedDeriv 2 (mfun ψ (beliefY P c t (hist P c t ω))) x ∧
        iteratedDeriv 2 (mfun ψ (beliefY P c t (hist P c t ω))) x ≤ 2) :
    ∃ c : Profile, (∀ t, Measurable (Function.uncurry (c t))) ∧
      (∀ t, ∀ᵐ ω ∂P, StrictMono (c t (hist P c t ω)) ∧
        ∃ S : Setting, S.g = (fun z => z ^ 2) ∧ S.F = typeLaw P c t (hist P c t ω) ∧
          S.ℓ = (fun x => κ * (mfun ψ (beliefY P c t (hist P c t ω)) x -
            mfun ψ (beliefY P c t (hist P c t ω)) S.μ)) ∧
          ∃ φ : ℝ → Measure EReal, S.IsCPBE (c t (hist P c t ω)) φ ∧
            S.D1Inf (c t (hist P c t ω)) φ) ∧
      ∀ᵐ r ∂(P.map thetaV), TendstoInMeasure (condDistrib id thetaV P r)
        (fun t => P[thetaV | histSigma P c t]) atTop (fun _ => r) := by
  subst hP
  -- the profile that plays `revealSel` at the realized public belief at every history
  obtain ⟨c, hcapp, hc⟩ : ∃ c : Profile,
      (∀ t h, c t h = revealSel κ ψ (beliefY (law Lθ Lε (vLaw ψ)) c t h)) ∧
        ∀ t, Measurable (Function.uncurry (c t)) :=
    ⟨ExAux.fixProf (law Lθ Lε (vLaw ψ)) (revealSel κ ψ),
      ExAux.fixProf_apply (law Lθ Lε (vLaw ψ)) (revealSel κ ψ),
      ExAux.measurable_fixProf (law Lθ Lε (vLaw ψ)) (revealSel κ ψ)
        (measurable_revealSel κ ψ hψc hψb)⟩
  -- by induction on the date, it is fully revealing at almost every history
  have hmono : ∀ t, ∀ᵐ ω ∂(law Lθ Lε (vLaw ψ)),
      StrictMono (c t (hist (law Lθ Lε (vLaw ψ)) c t ω)) := by
    intro t
    induction t using Nat.strong_induction_on with
    | _ t ih =>
      filter_upwards [hm c hc t ih] with ω hω
      rw [hcapp t]
      exact (revealSel_spec κ hκ0 hκ ψ _ hω.1 hω.2).1
  refine ⟨c, hc, fun t => ?_, propA5_learning_def Lθ Lε ψ hθ hψc hψpos _ rfl c hc hmono⟩
  filter_upwards [hmono t, hm c hc t (fun s _ => hmono s),
    typeLaw_eq_conv Lθ Lε ψ c hc t, beliefY_sq Lθ Lε ψ hθ c hc t]
    with ω hω hmω hconv hsq
  refine ⟨hω, ?_⟩
  obtain ⟨S, hSg, hSF, hSℓ⟩ := ExAux.exists_setting κ hκ0 hψc hψpos hψb hv2 hsymm h3
    (beliefY (law Lθ Lε (vLaw ψ)) c t (hist (law Lθ Lε (vLaw ψ)) c t ω)) hsq.1 hmω.1 hmω.2
    _ hconv
  obtain ⟨φ, hE, hD⟩ := (revealSel_spec κ hκ0 hκ ψ _ hmω.1 hmω.2).2 S hSg hSℓ
  refine ⟨S, hSg, hSF, hSℓ, φ, ?_, ?_⟩
  · rw [hcapp t]; exact hE
  · rw [hcapp t]; exact hD

end CC.LearnTheta
