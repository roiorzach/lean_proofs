import ConformityConcerns.LearnTheta.Defs

/-!
# A profile that plays a fixed selection from the public belief at every history

Given `sel : Measure ℝ → ℝ → ℝ`, `fixProf P sel` plays `sel (beliefY P c t h)` at date `t` after
history `h`, where `c` is the profile itself. This is well defined because the history `h^t`, and
hence the public belief `beliefY P c t`, depends only on the decisions of the periods before `t`:
the profile is built by recursion on the date.
-/

namespace CC.LearnTheta.ExAux

open MeasureTheory ProbabilityTheory

section Congr

variable (P : Measure Ω)

/-- The history at date `t` depends only on the strategies of the periods before `t`. -/
lemma hist_congr {c c' : Profile} :
    ∀ t, (∀ s, s < t → c s = c' s) → hist P c t = hist P c' t := by
  intro t
  induction t with
  | zero => intro _; rfl
  | succ t ih =>
    intro h
    have e1 := ih (fun s hs => h s (by omega))
    have e2 := h t (by omega)
    funext ω
    rw [hist_succ, hist_succ]
    unfold act vtil Ycond histSigma
    rw [e1, e2]

lemma Ycond_congr {c c' : Profile} (t : ℕ) (h : ∀ s, s < t → c s = c' s) :
    Ycond P c t = Ycond P c' t := by
  unfold Ycond histSigma
  rw [hist_congr P t h]

lemma beliefY_congr [IsFiniteMeasure P] {c c' : Profile} (t : ℕ)
    (h : ∀ s, s < t → c s = c' s) : beliefY P c t = beliefY P c' t := by
  unfold beliefY
  rw [Ycond_congr P t h, hist_congr P t h]

end Congr

variable (P : Measure Ω) [IsFiniteMeasure P] (sel : Measure ℝ → ℝ → ℝ)

/-- One step: play `sel` at the public belief generated by the profile `c`. -/
noncomputable def stepProf (c : Profile) : Profile := fun t h x => sel (beliefY P c t h) x

/-- `profSeq n` agrees with the final profile at the dates before `n`. -/
noncomputable def profSeq : ℕ → Profile
  | 0 => fun _ _ _ => 0
  | n + 1 => fun t => if t = n then stepProf P sel (profSeq n) t else profSeq n t

/-- The profile that plays `sel` at the realized public belief at every date. -/
noncomputable def fixProf : Profile := fun t => stepProf P sel (profSeq P sel t) t

lemma profSeq_eq : ∀ n t, t < n → profSeq P sel n t = fixProf P sel t := by
  intro n
  induction n with
  | zero => intro t ht; exact absurd ht (Nat.not_lt_zero _)
  | succ n ih =>
    intro t ht
    show (if t = n then stepProf P sel (profSeq P sel n) t else profSeq P sel n t) = _
    split_ifs with h
    · subst h; rfl
    · exact ih t (by omega)

/-- The defining property: at date `t` after history `h`, play `sel` at the public belief. -/
lemma fixProf_apply (t : ℕ) (h : Fin t → ℝ) :
    fixProf P sel t h = sel (beliefY P (fixProf P sel) t h) := by
  show sel (beliefY P (profSeq P sel t) t h) = _
  rw [beliefY_congr P t (fun s hs => profSeq_eq P sel t s hs)]

/-- If the selection is jointly measurable in the belief and the type, the profile is
measurable at every date. -/
lemma measurable_fixProf (hsel : Measurable (fun p : Measure ℝ × ℝ => sel p.1 p.2)) (t : ℕ) :
    Measurable (Function.uncurry (fixProf P sel t)) := by
  have e : Function.uncurry (fixProf P sel t) =
      fun p : (Fin t → ℝ) × ℝ => sel (beliefY P (fixProf P sel) t p.1) p.2 := by
    funext p
    rw [Function.uncurry_apply_pair, fixProf_apply]
  rw [e]
  exact hsel.comp (((beliefY P (fixProf P sel) t).measurable.comp measurable_fst).prodMk
    measurable_snd)

end CC.LearnTheta.ExAux
