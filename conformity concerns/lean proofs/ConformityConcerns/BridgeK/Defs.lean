import ConformityConcerns.Dynamics.Defs
import Mathlib.Probability.Distributions.Gaussian.Multivariate
import Mathlib.Probability.Kernel.CondDistrib
import Mathlib.Probability.ConditionalExpectation
import Mathlib.MeasureTheory.Function.ConvergenceInMeasure

/-!
# Social learning with heterogeneous conformity concerns and public disclosures

This generalizes the model of `Bridge/Defs.lean` in two ways.

* **Heterogeneous conformity concerns** (Online Appendix, "Heterogeneous Conformity Concerns"):
  at date `t` the public observes the pair `w_t = (κ_t, γ_t)`; the pairs are i.i.d. with law
  `G ⊗ Gγ` (so `κ_t ~ G` and `γ_t ~ Gγ` are independent of each other, over time, and of all other
  primitives). A constant conformity concern `κ` is the case `G = δ_κ`.
* **Public disclosures** (Section 5, "Policy Interventions"): a schedule `D` says, for each date
  `t`, whether a signal is publicly disclosed before the date-`t` action (after `a_{t-1}`).
  `D t = some (i, n)` discloses `x_i + √n ξ`, where `x = (θ, μ)`, `i = 0` is `θ`
  (individual-oriented) and `i = 1` is `μ` (peer-oriented), and `ξ ~ N(0,1)` is independent of
  everything else; `n = 1` is the paper's signal "distributed identically to `s_t`" (resp.
  `v_t`). `D t = none`: nothing is disclosed.

The primitives live on one probability space: `(θ, μ) ~ N(0, Σ₁)`, a sequence of noise vectors
`(ξ_k)_k` i.i.d. `N(0, I₂)`, and the weights `(w_t)_t` i.i.d. `G ⊗ Gγ`, all independent. Player
`t`'s private information is `(s_t, v_t) = (θ, μ) + ξ_{2t+1}`; the noise of a signal disclosed at
date `t` is the `i`-th coordinate of `ξ_{2t}` (so even-indexed noises are used only by
disclosures).

`SigK S₁ D w t` is `Σ_t`, the covariance of the public beliefs at `h^t` (after the disclosure at
date `t`, if any): a disclosure updates the covariance by `observeTheta` / `observeMu`, and date
`t` is revealing iff `κ_t s̃(Σ_t, γ_t)² ≤ κck` (Corollary 1), in which case the public observes
`Z_t` and `Σ` is updated by `kalman`. The equilibrium action (`eqActK`) is that of
`Bridge.eqAct` with `κ_t` in place of `κ`. The public history
`h^t = (w_0, d_0, a_0, …, w_{t-1}, d_{t-1}, a_{t-1}, w_t, d_t)` (with `d_s` the value disclosed at
date `s`, `0` if none) generates `histSigmaK t`, and `θ(h^t) = E(θ | h^t)` is `postThetaK`.

As in `Bridge`, the posterior means used inside the equilibrium actions are conditional
expectations given `infoSigmaK t`, generated by the weights, the disclosures and the informative
parts `obsK` of past actions; `BridgeK/Hist.lean` states that `histSigmaK t = infoSigmaK t`, so
they are the posterior means given the public history.
-/

namespace CC.BridgeK

open MeasureTheory ProbabilityTheory Filter Topology

set_option warn.classDefReducibility false

/-- `ℝ²`. -/
abbrev E2 := EuclideanSpace ℝ (Fin 2)

/-- Sample space `((θ, μ), (ξ_k)_k, ((κ_t, γ_t))_t)`. -/
abbrev Ωk := E2 × ((ℕ → E2) × (ℕ → ℝ × ℝ))

/-- The law of the primitives: `(θ, μ) ~ N(0, Σ₁)`, `ξ_k` i.i.d. `N(0, I₂)`, `(κ_t, γ_t)` i.i.d.
`G ⊗ Gγ`, all independent. -/
noncomputable def lawK (S₁ : M2) (G Gγ : Measure ℝ) : Measure Ωk :=
  (multivariateGaussian 0 S₁).prod
    ((Measure.infinitePi fun _ : ℕ => stdGaussian E2).prod
      (Measure.infinitePi fun _ : ℕ => G.prod Gγ))

instance (S₁ : M2) (G Gγ : Measure ℝ) [IsProbabilityMeasure G] [IsProbabilityMeasure Gγ] :
    IsProbabilityMeasure (lawK S₁ G Gγ) := by
  unfold lawK; infer_instance

/-- (Instance search does not find this product unaided.) -/
instance instStandardBorelNoiseWts : StandardBorelSpace ((ℕ → E2) × (ℕ → ℝ × ℝ)) :=
  StandardBorelSpace.prod

/-- `Ωk` is a standard Borel space (needed for `condDistrib`). -/
instance instStandardBorelΩk : StandardBorelSpace Ωk := StandardBorelSpace.prod

/-- The fundamental state `θ`. -/
def thetaV (ω : Ωk) : ℝ := ω.1 0

/-- The average preference `μ`. -/
def muV (ω : Ωk) : ℝ := ω.1 1

/-- The noise vector `ξ_k`. -/
def noise (k : ℕ) (ω : Ωk) : E2 := ω.2.1 k

/-- The realised weights `(w_t)_t = ((κ_t, γ_t))_t`. -/
def wts (ω : Ωk) : ℕ → ℝ × ℝ := ω.2.2

/-- The conformity concern `κ_t`. -/
def kap (ω : Ωk) (t : ℕ) : ℝ := (wts ω t).1

/-- The weight `γ_t` of the fundamental state. -/
def gam (ω : Ωk) (t : ℕ) : ℝ := (wts ω t).2

/-- Player `t`'s private information `(s_t, v_t) = (θ, μ) + (ε_t, ν_t)`, with
`(ε_t, ν_t) = ξ_{2t+1}`. -/
def priv (t : ℕ) (ω : Ωk) : E2 := ω.1 + noise (2 * t + 1) ω

/-! ### Disclosure schedules -/

/-- A disclosure schedule: `D t = some (i, n)` publicly discloses `x_i + √n ξ` before the date-`t`
action (`i = 0`: `θ`, `i = 1`: `μ`; `n ≥ 0` is the noise variance); `D t = none`: no
disclosure. -/
abbrev Sched := ℕ → Option (Fin 2 × ℝ)

/-- No disclosures (the model of Section 2). -/
def noDisc : Sched := fun _ => none

/-- A single disclosure `x_i + √n ξ` at date `τ`. -/
def interventionAt (τ : ℕ) (i : Fin 2) (n : ℝ) : Sched :=
  fun t => if t = τ then some (i, n) else none

/-- An individual-oriented intervention at date `τ`: the public disclosure of `θ + √n ξ`
(`n = 1`: a signal distributed identically to `s_t`). -/
def individualAt (τ : ℕ) (n : ℝ) : Sched := interventionAt τ 0 n

/-- A peer-oriented intervention at date `τ`: the public disclosure of `μ + √n ξ`
(`n = 1`: a signal distributed identically to `v_t`). -/
def peerAt (τ : ℕ) (n : ℝ) : Sched := interventionAt τ 1 n

/-- The value `d_t` disclosed at date `t` (`0` if nothing is disclosed): `x_i + √n (ξ_{2t})_i`. -/
noncomputable def discVal (D : Sched) (t : ℕ) (ω : Ωk) : ℝ :=
  match D t with
  | none => 0
  | some (i, n) => ω.1 i + √n * noise (2 * t) ω i

/-- The posterior covariance after a disclosure: `observeTheta S n` after `θ + √n ξ`,
`observeMu S n` after `μ + √n ξ`, `S` if nothing is disclosed. -/
noncomputable def discCov (d : Option (Fin 2 × ℝ)) (S : M2) : M2 :=
  match d with
  | none => S
  | some (i, n) => if i = 0 then observeTheta S n else observeMu S n

/-! ### The covariance process -/

/-- The covariance after a date with conformity concern `κ`, weight `γ` and covariance `S` at the
time of the action: `kalman S γ` if the date is revealing (Corollary 1), `S` otherwise. -/
noncomputable def stepCov (κ γ : ℝ) (S : M2) : M2 :=
  haveI := Classical.propDecidable (revCrit κ S γ)
  if revCrit κ S γ then kalman S γ else S

/-- The covariance at the start of date `t`, before the disclosure at date `t` (if any), along
the weight path `w`. -/
noncomputable def SigPre (S₁ : M2) (D : Sched) (w : ℕ → ℝ × ℝ) : ℕ → M2
  | 0 => S₁
  | t + 1 => stepCov (w t).1 (w t).2 (discCov (D t) (SigPre S₁ D w t))

/-- `Σ_t`: the covariance of the public beliefs at `h^t` (after the disclosure at date `t`, if
any), along the weight path `w`. -/
noncomputable def SigK (S₁ : M2) (D : Sched) (w : ℕ → ℝ × ℝ) (t : ℕ) : M2 :=
  discCov (D t) (SigPre S₁ D w t)

/-- Date `t` is revealing: `κ_t s̃(h^t)² ≤ κck` (Corollary 1). -/
def revK (S₁ : M2) (D : Sched) (t : ℕ) (ω : Ωk) : Prop :=
  revCrit (kap ω t) (SigK S₁ D (wts ω) t) (gam ω t)

/-- The informative part of the date-`t` action: `A_t · (s_t, v_t)` if revealing, else `0`. -/
noncomputable def obsK (S₁ : M2) (D : Sched) (t : ℕ) (ω : Ωk) : ℝ :=
  haveI := Classical.propDecidable (revK S₁ D t ω)
  if revK S₁ D t ω then
    loadA (SigK S₁ D (wts ω) t) (gam ω t) 0 * priv t ω 0 +
      loadA (SigK S₁ D (wts ω) t) (gam ω t) 1 * priv t ω 1
  else 0

/-- σ-algebra generated by `w_0, …, w_t`, the disclosures `d_0, …, d_t` and the observations at
dates `< t`. -/
noncomputable def infoSigmaK (S₁ : M2) (D : Sched) (t : ℕ) : MeasurableSpace Ωk :=
  MeasurableSpace.comap
    (fun ω => ((fun i : Fin (t + 1) => wts ω i), (fun i : Fin (t + 1) => discVal D i ω),
      (fun i : Fin t => obsK S₁ D i ω))) inferInstance

/-- The posterior mean of `θ` given `infoSigmaK t` (equal to `θ(h^t)`, see `BridgeK/Hist.lean`). -/
noncomputable def postThetaI (S₁ : M2) (G Gγ : Measure ℝ) (D : Sched) (t : ℕ) : Ωk → ℝ :=
  (lawK S₁ G Gγ)[thetaV | infoSigmaK S₁ D t]

/-- The posterior mean of `μ` given `infoSigmaK t` (equal to `μ(h^t)`, see `BridgeK/Hist.lean`). -/
noncomputable def postMuI (S₁ : M2) (G Gγ : Measure ℝ) (D : Sched) (t : ℕ) : Ωk → ℝ :=
  (lawK S₁ G Gγ)[muV | infoSigmaK S₁ D t]

/-- The equilibrium action `a_t`: at a revealing date
`a_t = γ_t θ(h^t) + μ(h^t) + λ_t (Z_t - E(Z_t | h^t))` with
`λ_t = (1 + √(1 - 4 κ_t s̃²))/2` and `Z_t - E(Z_t | h^t) = A_t · ((s_t, v_t) - (θ(h^t), μ(h^t)))`;
at a pooling date `a_t = γ_t θ(h^t) + μ(h^t)`. -/
noncomputable def eqActK (S₁ : M2) (G Gγ : Measure ℝ) (D : Sched) (t : ℕ) (ω : Ωk) : ℝ :=
  haveI := Classical.propDecidable (revK S₁ D t ω)
  let S := SigK S₁ D (wts ω) t
  let κ := kap ω t
  let γ := gam ω t
  let mθ := postThetaI S₁ G Gγ D t ω
  let mμ := postMuI S₁ G Gγ D t ω
  if revK S₁ D t ω then
    γ * mθ + mμ + (1 + √(1 - 4 * κ * sens S γ ^ 2)) / 2 *
      (obsK S₁ D t ω - (loadA S γ 0 * mθ + loadA S γ 1 * mμ))
  else γ * mθ + mμ

/-- σ-algebra of the public history
`h^t = (w_0, d_0, a_0, …, w_{t-1}, d_{t-1}, a_{t-1}, w_t, d_t)`. -/
noncomputable def histSigmaK (S₁ : M2) (G Gγ : Measure ℝ) (D : Sched) (t : ℕ) :
    MeasurableSpace Ωk :=
  MeasurableSpace.comap
    (fun ω => ((fun i : Fin (t + 1) => wts ω i), (fun i : Fin (t + 1) => discVal D i ω),
      (fun i : Fin t => eqActK S₁ G Gγ D i ω))) inferInstance

/-- `θ(h^t) = E(θ | h^t)`. -/
noncomputable def postThetaK (S₁ : M2) (G Gγ : Measure ℝ) (D : Sched) (t : ℕ) : Ωk → ℝ :=
  (lawK S₁ G Gγ)[thetaV | histSigmaK S₁ G Gγ D t]

/-- `μ(h^t) = E(μ | h^t)`. -/
noncomputable def postMuK (S₁ : M2) (G Gγ : Measure ℝ) (D : Sched) (t : ℕ) : Ωk → ℝ :=
  (lawK S₁ G Gγ)[muV | histSigmaK S₁ G Gγ D t]

/-! ### The paper's definition of social learning -/

section SL

variable {Ω : Type*} [MeasurableSpace Ω] [StandardBorelSpace Ω] [Nonempty Ω]

/-- Social learning about `X` (`θ` or `μ`) occurs: for almost every realisation `r` of `X`, the
posterior mean converges in probability to `r` conditionally on `X = r`. -/
def SLOccurs (P : Measure Ω) [IsFiniteMeasure P] (X : Ω → ℝ) (post : ℕ → Ω → ℝ) : Prop :=
  ∀ᵐ r ∂(P.map X), TendstoInMeasure (condDistrib id X P r) post atTop (fun _ => r)

/-- Social learning about `X` fails: for almost every realisation `r` of `X`, the posterior mean
does not converge in probability to `r` conditionally on `X = r`. -/
def SLFails (P : Measure Ω) [IsFiniteMeasure P] (X : Ω → ℝ) (post : ℕ → Ω → ℝ) : Prop :=
  ∀ᵐ r ∂(P.map X), ¬ TendstoInMeasure (condDistrib id X P r) post atTop (fun _ => r)

end SL

end CC.BridgeK
