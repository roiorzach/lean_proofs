import ConformityConcerns.BridgeK.Kalman

/-!
# The slot signals on the sample space and the information filtration

`uS k ω` is the slot-`k` signal: `uS (2t) = discVal D t` (the disclosure at date `t`) and
`uS (2t+1) = obsK S₁ D t` (the informative part of the date-`t` action). `infoSigmaK t` is a
filtration, every measurable function of `(w_0, …, w_t, u_0, …, u_{2t})` is
`infoSigmaK t`-measurable, and all the information is generated by `(w, u)`.
-/

namespace CC.BridgeK

open MeasureTheory ProbabilityTheory Filter Topology Matrix

set_option warn.classDefReducibility false

lemma k_of_eval {α ι β : Type*} [MeasurableSpace β] {m : MeasurableSpace α} {f : α → ι → β}
    (h : ∀ i, Measurable[m] (fun x => f x i)) : Measurable[m] f := by
  let _ := m; exact Measurable.of_eval h

variable (S₁ : M2) (D : Sched)

/-- The slot signals on the sample space. -/
noncomputable def uS (k : ℕ) (ω : Ωk) : ℝ := sigF S₁ D (wts ω) ω.1 ω.2.1 k

lemma uS_even (t : ℕ) (ω : Ωk) : uS S₁ D (2 * t) ω = discVal D t ω := by
  unfold uS sigF
  rw [ld_even]
  unfold discVal
  rcases h : D t with _ | ⟨i, n⟩
  · simp [ldD, ZG]
  · simp only [ldD]
    rw [ZG_disc]
    rfl

lemma uS_odd (t : ℕ) (ω : Ωk) : uS S₁ D (2 * t + 1) ω = obsK S₁ D t ω := by
  unfold uS sigF obsK
  rw [ld_odd]
  unfold ldA
  by_cases h : revK S₁ D t ω
  · have h' : revCrit (wts ω t).1 (SigK S₁ D (wts ω) t) (wts ω t).2 := h
    rw [ite_eq_left h', ite_eq_left h]
    simp only [ZG, priv, noise, gam, PiLp.add_apply]
    ring
  · have h' : ¬ revCrit (wts ω t).1 (SigK S₁ D (wts ω) t) (wts ω t).2 := h
    rw [ite_eq_right h', ite_eq_right h]
    simp [ZG]

lemma measurable_wts : Measurable wts := measurable_snd.comp measurable_snd

lemma measurable_wts_apply (i : ℕ) : Measurable (fun ω : Ωk => wts ω i) :=
  (measurable_pi_apply i).comp measurable_wts

lemma measurable_uS (k : ℕ) : Measurable (uS S₁ D k) := by
  obtain ⟨a0, b0⟩ := measurable_ld_pair S₁ D k 0
  obtain ⟨a1, b1⟩ := measurable_ld_pair S₁ D k 1
  have x0 : Measurable (fun ω : Ωk => ω.1 0) := Bridge.br_meas_coord measurable_fst 0
  have x1 : Measurable (fun ω : Ωk => ω.1 1) := Bridge.br_meas_coord measurable_fst 1
  have hξ : Measurable (fun ω : Ωk => ω.2.1 k) :=
    (measurable_pi_apply k).comp (measurable_fst.comp measurable_snd)
  have ξ0 := Bridge.br_meas_coord hξ 0
  have ξ1 := Bridge.br_meas_coord hξ 1
  have e : uS S₁ D k = fun ω => ((ld S₁ D (wts ω) k).1 0 * ω.1 0 + (ld S₁ D (wts ω) k).1 1 * ω.1 1)
      + ((ld S₁ D (wts ω) k).2 0 * ω.2.1 k 0 + (ld S₁ D (wts ω) k).2 1 * ω.2.1 k 1) := rfl
  rw [e]
  exact (((a0.comp measurable_wts).mul x0).add ((a1.comp measurable_wts).mul x1)).add
    (((b0.comp measurable_wts).mul ξ0).add ((b1.comp measurable_wts).mul ξ1))

lemma measurable_uSeq : Measurable (fun ω : Ωk => fun k => uS S₁ D k ω) :=
  Measurable.of_eval fun k => measurable_uS S₁ D k

lemma measurable_discVal (t : ℕ) : Measurable (discVal D t) := by
  have e : discVal D t = uS 0 D (2 * t) := funext fun ω => (uS_even 0 D t ω).symm
  rw [e]; exact measurable_uS 0 D _

lemma measurable_obsK (t : ℕ) : Measurable (obsK S₁ D t) := by
  have e : obsK S₁ D t = uS S₁ D (2 * t + 1) := funext fun ω => (uS_odd S₁ D t ω).symm
  rw [e]; exact measurable_uS S₁ D _

/-! ### Reconstruction from the information vector -/

/-- Extension by `0` of a finite sequence of weights. -/
def extW (n : ℕ) (g : Fin n → ℝ × ℝ) : ℕ → ℝ × ℝ := fun i => if h : i < n then g ⟨i, h⟩ else 0

lemma measurable_extW (n : ℕ) : Measurable (extW n) := by
  refine Measurable.of_eval fun i => ?_
  unfold extW
  by_cases h : i < n
  · simp only [h, dite_eq_left]; exact measurable_pi_apply _
  · simp only [h, dite_eq_right, not_false_eq_true]; exact measurable_const

lemma extW_apply_lt {n : ℕ} (g : Fin n → ℝ × ℝ) {i : ℕ} (h : i < n) : extW n g i = g ⟨i, h⟩ :=
  dite_eq_left h

/-- The slot signals before slot `2t + 1` from the disclosures and the observations. -/
noncomputable def extU (t : ℕ) (q : (Fin (t + 1) → ℝ) × (Fin t → ℝ)) : ℕ → ℝ := fun k =>
  if k % 2 = 0 then Bridge.extF (t + 1) q.1 (k / 2) else Bridge.extF t q.2 (k / 2)

lemma measurable_extU (t : ℕ) : Measurable (extU t) := by
  refine Measurable.of_eval fun k => ?_
  by_cases h : k % 2 = 0
  · have e : (fun q => extU t q k) = fun q => Bridge.extF (t + 1) q.1 (k / 2) := by
      funext q; simp [extU, h]
    rw [e]
    exact (measurable_pi_apply (k / 2)).comp ((Bridge.measurable_extF (t + 1)).comp measurable_fst)
  · have e : (fun q => extU t q k) = fun q => Bridge.extF t q.2 (k / 2) := by
      funext q; simp [extU, h]
    rw [e]
    exact (measurable_pi_apply (k / 2)).comp ((Bridge.measurable_extF t).comp measurable_snd)

/-- The information vector at date `t` (it generates `infoSigmaK S₁ D t`). -/
noncomputable def infoMap (t : ℕ) (ω : Ωk) :
    (Fin (t + 1) → ℝ × ℝ) × (Fin (t + 1) → ℝ) × (Fin t → ℝ) :=
  ((fun i : Fin (t + 1) => wts ω i), (fun i : Fin (t + 1) => discVal D i ω),
    (fun i : Fin t => obsK S₁ D i ω))

lemma infoSigmaK_eq_comap (t : ℕ) :
    infoSigmaK S₁ D t = MeasurableSpace.comap (infoMap S₁ D t) inferInstance := rfl

/-- The reconstruction map from the information vector. -/
noncomputable def recon (t : ℕ) (q : (Fin (t + 1) → ℝ × ℝ) × (Fin (t + 1) → ℝ) × (Fin t → ℝ)) :
    (ℕ → ℝ × ℝ) × (ℕ → ℝ) :=
  (extW (t + 1) q.1, extU t q.2)

lemma measurable_recon (t : ℕ) : Measurable (recon t) :=
  ((measurable_extW _).comp measurable_fst).prodMk ((measurable_extU t).comp measurable_snd)

lemma recon_wts (t : ℕ) (ω : Ωk) {s : ℕ} (hs : s ≤ t) :
    (recon t (infoMap S₁ D t ω)).1 s = wts ω s := by
  simp only [recon, infoMap]
  rw [extW_apply_lt _ (Nat.lt_succ_of_le hs)]

lemma recon_uS (t : ℕ) (ω : Ωk) {k : ℕ} (hk : k < 2 * t + 1) :
    (recon t (infoMap S₁ D t ω)).2 k = uS S₁ D k ω := by
  simp only [recon, infoMap, extU]
  obtain ⟨s, rfl | rfl⟩ := Nat.even_or_odd' k
  · rw [ite_eq_left (two_mul_mod s), two_mul_div, Bridge.extF_apply_lt _ (by omega), uS_even]
  · rw [ite_eq_right (by rw [two_mul_add_mod]; omega), two_mul_add_div,
      Bridge.extF_apply_lt _ (by omega), uS_odd]

/-- Every measurable function of `(w_0, …, w_t, u_0, …, u_{2t})` is `infoSigmaK t`-measurable. -/
lemma meas_info_of_dep {β : Type*} [MeasurableSpace β] (t : ℕ)
    (F : (ℕ → ℝ × ℝ) × (ℕ → ℝ) → β) (hF : Measurable F)
    (hdep : ∀ (w w' : ℕ → ℝ × ℝ) (y y' : ℕ → ℝ), (∀ s ≤ t, w s = w' s) →
      (∀ k < 2 * t + 1, y k = y' k) → F (w, y) = F (w', y')) :
    Measurable[infoSigmaK S₁ D t] (fun ω => F (wts ω, fun k => uS S₁ D k ω)) := by
  have h : (fun ω => F (wts ω, fun k => uS S₁ D k ω)) =
      (fun q => F (recon t q)) ∘ infoMap S₁ D t := by
    funext ω
    simp only [Function.comp]
    exact hdep _ _ _ _ (fun s hs => (recon_wts S₁ D t ω hs).symm)
      (fun k hk => (recon_uS S₁ D t ω hk).symm)
  rw [h, infoSigmaK_eq_comap]
  exact (hF.comp (measurable_recon t)).comp (comap_measurable _)

lemma meas_info_wts {t i : ℕ} (hi : i ≤ t) :
    Measurable[infoSigmaK S₁ D t] (fun ω => wts ω i) :=
  meas_info_of_dep S₁ D t (fun p => p.1 i) ((measurable_pi_apply i).comp measurable_fst)
    (fun _ _ _ _ h1 _ => h1 i hi)

lemma meas_info_uS {t k : ℕ} (hk : k < 2 * t + 1) :
    Measurable[infoSigmaK S₁ D t] (uS S₁ D k) :=
  meas_info_of_dep S₁ D t (fun p => p.2 k) ((measurable_pi_apply k).comp measurable_snd)
    (fun _ _ _ _ _ h2 => h2 k hk)

lemma meas_info_discVal {t i : ℕ} (hi : i ≤ t) :
    Measurable[infoSigmaK S₁ D t] (discVal D i) := by
  have e : discVal D i = uS S₁ D (2 * i) := funext fun ω => (uS_even S₁ D i ω).symm
  rw [e]; exact meas_info_uS S₁ D (by omega)

lemma meas_info_obsK {t i : ℕ} (hi : i < t) :
    Measurable[infoSigmaK S₁ D t] (obsK S₁ D i) := by
  have e : obsK S₁ D i = uS S₁ D (2 * i + 1) := funext fun ω => (uS_odd S₁ D i ω).symm
  rw [e]; exact meas_info_uS S₁ D (by omega)

lemma measurable_infoMap (t : ℕ) : Measurable (infoMap S₁ D t) :=
  (Measurable.of_eval fun (i : Fin (t + 1)) => measurable_wts_apply i).prodMk
    ((Measurable.of_eval fun (i : Fin (t + 1)) => measurable_discVal D i).prodMk
      (Measurable.of_eval fun (i : Fin t) => measurable_obsK S₁ D i))

lemma infoSigmaK_le (t : ℕ) : infoSigmaK S₁ D t ≤ (inferInstance : MeasurableSpace Ωk) :=
  (measurable_infoMap S₁ D t).comap_le

lemma infoSigmaK_mono : Monotone (infoSigmaK S₁ D) := by
  intro s t hst
  refine Measurable.comap_le ?_
  exact (k_of_eval fun (i : Fin (s + 1)) =>
    meas_info_wts S₁ D (Nat.le_trans (Nat.lt_succ_iff.1 i.2) hst)).prodMk
    ((k_of_eval fun (i : Fin (s + 1)) =>
      meas_info_discVal S₁ D (Nat.le_trans (Nat.lt_succ_iff.1 i.2) hst)).prodMk
      (k_of_eval fun (i : Fin s) => meas_info_obsK S₁ D (Nat.lt_of_lt_of_le i.2 hst)))

/-- The information filtration. -/
noncomputable def infoFiltK : Filtration ℕ (inferInstance : MeasurableSpace Ωk) :=
  ⟨infoSigmaK S₁ D, infoSigmaK_mono S₁ D, infoSigmaK_le S₁ D⟩

lemma infoFiltK_apply (t : ℕ) : infoFiltK S₁ D t = infoSigmaK S₁ D t := rfl

/-- All the information is generated by `(w, u)`. -/
lemma iSup_infoSigmaK_le :
    (⨆ t, infoSigmaK S₁ D t) ≤
      MeasurableSpace.comap (fun ω : Ωk => (wts ω, fun k => uS S₁ D k ω)) inferInstance := by
  refine iSup_le fun t => ?_
  have hR : Measurable (fun p : (ℕ → ℝ × ℝ) × (ℕ → ℝ) =>
      ((fun i : Fin (t + 1) => p.1 i), (fun i : Fin (t + 1) => p.2 (2 * i)),
        (fun i : Fin t => p.2 (2 * i + 1)))) :=
    (Measurable.of_eval fun i => (measurable_pi_apply _).comp measurable_fst).prodMk
      ((Measurable.of_eval fun i => (measurable_pi_apply _).comp measurable_snd).prodMk
        (Measurable.of_eval fun i => (measurable_pi_apply _).comp measurable_snd))
  have e : infoMap S₁ D t = (fun p : (ℕ → ℝ × ℝ) × (ℕ → ℝ) =>
      ((fun i : Fin (t + 1) => p.1 i), (fun i : Fin (t + 1) => p.2 (2 * i)),
        (fun i : Fin t => p.2 (2 * i + 1)))) ∘ (fun ω : Ωk => (wts ω, fun k => uS S₁ D k ω)) := by
    funext ω
    simp only [infoMap, Function.comp, uS_even, uS_odd]
  rw [infoSigmaK_eq_comap, e]
  exact (hR.comp (comap_measurable _)).comap_le

end CC.BridgeK
