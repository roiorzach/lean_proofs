import WhoVsWhen.Lemma1
import Mathlib.MeasureTheory.Function.ConditionalExpectation.Real
import Mathlib.MeasureTheory.Function.ConditionalExpectation.PullOut
import Mathlib.Probability.Independence.Integration
import Mathlib.MeasureTheory.Function.L2Space

/-!
# The probability model

The states `θ₁, θ₂` are independent, square-integrable random variables with mean zero (`Env`).
Unit `i`'s message generates a σ-algebra `Fᵢ` coarser than `σ(θᵢ)`, so the message is a function of
the unit's own state. The posterior means are the conditional expectations `μᵢ = 𝔼(θᵢ | Fᵢ)`. The
volatilities are `σᵢ² = 𝔼 θᵢ²`, and the information losses are `cᵢ = 𝔼 (θᵢ - μᵢ)²`. Decisions follow
the rules of Lemma 1.

This file computes the expected losses for every message structure: `leader_loss_eq` and
`follower_loss_eq` (used by Lemma 3), `conc_loss_eq` (used by Lemma 4), and `coord_seq`. The
proofs decompose `θᵢ = μᵢ + εᵢ`. The four variables `ε₁, μ₁, ε₂, μ₂` are orthogonal in `L²`, with
`𝔼 εᵢ² = cᵢ` and `𝔼 μᵢ² = σᵢ² - cᵢ`.
-/

namespace WhoVsWhen

open MeasureTheory ProbabilityTheory

/-! ### Closed forms -/

/-- Equation (2): the leader's expected loss, `(1 - r_L) γ_L (σ_L² + σ_F²) + γ_L β_L c_F`. -/
noncomputable def leaderLossF (rL rF sL sF cF : ℝ) : ℝ :=
  (1 - rL) * γ rL rF * (sL + sF) + γ rL rF * β rL rF * cF

/-- Equation (3): the follower's expected loss,
`(1 - r_F) r_F (1 - γ_L)² (σ_L² + σ_F²) - (1 - r_F) r_F (γ_L² - 2 γ_L) c_F`. -/
noncomputable def followerLossF (rL rF sL sF cF : ℝ) : ℝ :=
  (1 - rF) * rF * (1 - γ rL rF) ^ 2 * (sL + sF) - (1 - rF) * rF * (γ rL rF ^ 2 - 2 * γ rL rF) * cF

/-- Lemma 4 (corrected): unit `i`'s expected loss under concurrent decision-making,
`(σᵢ² + σⱼ²)(1 - rᵢ)βᵢ/(1 - rᵢrⱼ)² + rᵢ(1 - rᵢ) ((1 - rᵢrⱼ)² - (1 - rⱼ)²)/(1 - rᵢrⱼ)² · cᵢ
  + rᵢ(1 - rⱼ)² ((1 - rᵢrⱼ)² - (1 - rᵢ))/(1 - rᵢrⱼ)² · cⱼ`.
The paper prints `(1 - r₁)²` where the coefficient on `c₁` has `(1 - r₂)²`. -/
noncomputable def concLossF (ri rj si sj ci cj : ℝ) : ℝ :=
  (si + sj) * (1 - ri) * β ri rj / Dn ri rj ^ 2
    + ri * (1 - ri) * (Dn ri rj ^ 2 - (1 - rj) ^ 2) / Dn ri rj ^ 2 * ci
    + ri * (1 - rj) ^ 2 * (Dn ri rj ^ 2 - (1 - ri)) / Dn ri rj ^ 2 * cj

/-- Expected coordination loss `𝔼 (d₁ - d₂)²` under sequential decision-making (leader `L`). -/
noncomputable def coordSeqF (rL rF sL sF cF : ℝ) : ℝ :=
  (1 - rF) ^ 2 * (cF + (1 - γ rL rF) ^ 2 * (sL + sF - cF))

/-! ### The probability model -/

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]

/-- The information environment: independent, square-integrable, mean-zero states, and the
σ-algebras `F₁, F₂` generated by the two units' messages (each a function of the sender's own
state). -/
structure Env (Ω : Type*) [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P] where
  /-- Unit 1's local condition. -/
  θ₁ : Ω → ℝ
  /-- Unit 2's local condition. -/
  θ₂ : Ω → ℝ
  /-- The σ-algebra generated by unit 1's message. -/
  F₁ : MeasurableSpace Ω
  /-- The σ-algebra generated by unit 2's message. -/
  F₂ : MeasurableSpace Ω
  meas₁ : Measurable[mΩ] θ₁
  meas₂ : Measurable[mΩ] θ₂
  /-- Unit 1's message is a function of `θ₁`. -/
  hF₁ : F₁ ≤ MeasurableSpace.comap θ₁ inferInstance
  /-- Unit 2's message is a function of `θ₂`. -/
  hF₂ : F₂ ≤ MeasurableSpace.comap θ₂ inferInstance
  indep : IndepFun θ₁ θ₂ P
  L2₁ : MemLp θ₁ 2 P
  L2₂ : MemLp θ₂ 2 P
  mean₁ : ∫ ω, θ₁ ω ∂P = 0
  mean₂ : ∫ ω, θ₂ ω ∂P = 0

namespace Env

variable (E : Env Ω P)

/-- The environment seen with the units' labels exchanged. -/
def swap : Env Ω P where
  θ₁ := E.θ₂
  θ₂ := E.θ₁
  F₁ := E.F₂
  F₂ := E.F₁
  meas₁ := E.meas₂
  meas₂ := E.meas₁
  hF₁ := E.hF₂
  hF₂ := E.hF₁
  indep := E.indep.symm
  L2₁ := E.L2₂
  L2₂ := E.L2₁
  mean₁ := E.mean₂
  mean₂ := E.mean₁

/-- Posterior mean `μ₁ = 𝔼(θ₁ | m₁)`. -/
noncomputable def μ₁ : Ω → ℝ := P[E.θ₁ | E.F₁]
/-- Posterior mean `μ₂ = 𝔼(θ₂ | m₂)`. -/
noncomputable def μ₂ : Ω → ℝ := P[E.θ₂ | E.F₂]
/-- Volatility `σ₁² = Var θ₁`. -/
noncomputable def s₁ : ℝ := ∫ ω, E.θ₁ ω ^ 2 ∂P
/-- Volatility `σ₂² = Var θ₂`. -/
noncomputable def s₂ : ℝ := ∫ ω, E.θ₂ ω ^ 2 ∂P
/-- Information loss `c₁ = Var(θ₁ - 𝔼(θ₁ | m₁))`. -/
noncomputable def c₁ : ℝ := ∫ ω, (E.θ₁ ω - E.μ₁ ω) ^ 2 ∂P
/-- Information loss `c₂ = Var(θ₂ - 𝔼(θ₂ | m₂))`. -/
noncomputable def c₂ : ℝ := ∫ ω, (E.θ₂ ω - E.μ₂ ω) ^ 2 ∂P

@[simp] lemma swap_θ₁ : E.swap.θ₁ = E.θ₂ := rfl
@[simp] lemma swap_θ₂ : E.swap.θ₂ = E.θ₁ := rfl
@[simp] lemma swap_μ₁ : E.swap.μ₁ = E.μ₂ := rfl
@[simp] lemma swap_μ₂ : E.swap.μ₂ = E.μ₁ := rfl
@[simp] lemma swap_s₁ : E.swap.s₁ = E.s₂ := rfl
@[simp] lemma swap_s₂ : E.swap.s₂ = E.s₁ := rfl
@[simp] lemma swap_c₁ : E.swap.c₁ = E.c₂ := rfl
@[simp] lemma swap_c₂ : E.swap.c₂ = E.c₁ := rfl

/-! #### Decisions (Lemma 1) -/

/-- Sequential decision-making, unit 1 leads: the leader's decision `(1 - γ₁) θ₁ + γ₁ μ₂`. -/
noncomputable def seqD₁ (r₁ r₂ : ℝ) (ω : Ω) : ℝ :=
  (1 - γ r₁ r₂) * E.θ₁ ω + γ r₁ r₂ * E.μ₂ ω
/-- Sequential decision-making, unit 1 leads: the follower's decision `(1 - r₂) θ₂ + r₂ d₁`. -/
noncomputable def seqD₂ (r₁ r₂ : ℝ) (ω : Ω) : ℝ :=
  (1 - r₂) * E.θ₂ ω + r₂ * E.seqD₁ r₁ r₂ ω
/-- Concurrent decision-making: unit 1's decision. -/
noncomputable def concD₁ (r₁ r₂ : ℝ) (ω : Ω) : ℝ := concRule r₁ r₂ (E.θ₁ ω) (E.μ₁ ω) (E.μ₂ ω)
/-- Concurrent decision-making: unit 2's decision. -/
noncomputable def concD₂ (r₁ r₂ : ℝ) (ω : Ω) : ℝ := concRule r₂ r₁ (E.θ₂ ω) (E.μ₂ ω) (E.μ₁ ω)

lemma swap_concD₁ (r₁ r₂ : ℝ) : E.swap.concD₁ r₂ r₁ = E.concD₂ r₁ r₂ := rfl
lemma swap_concD₂ (r₁ r₂ : ℝ) : E.swap.concD₂ r₂ r₁ = E.concD₁ r₁ r₂ := rfl

/-! #### Moments -/

lemma hF₁le : E.F₁ ≤ mΩ := E.hF₁.trans E.meas₁.comap_le
lemma hF₂le : E.F₂ ≤ mΩ := E.hF₂.trans E.meas₂.comap_le

lemma memLp_μ₁ : MemLp E.μ₁ 2 P := E.L2₁.condExp one_le_two
lemma memLp_μ₂ : MemLp E.μ₂ 2 P := E.L2₂.condExp one_le_two

lemma memLp_ε₁ : MemLp (fun ω => E.θ₁ ω - E.μ₁ ω) 2 P := E.L2₁.sub E.memLp_μ₁
lemma memLp_ε₂ : MemLp (fun ω => E.θ₂ ω - E.μ₂ ω) 2 P := E.L2₂.sub E.memLp_μ₂

lemma integral_μ₁ : ∫ ω, E.μ₁ ω ∂P = 0 := by
  rw [μ₁, integral_condExp E.hF₁le, E.mean₁]
lemma integral_μ₂ : ∫ ω, E.μ₂ ω ∂P = 0 := E.swap.integral_μ₁

/-- `𝔼[μ θ] = 𝔼[μ²]`: the pull-out property of conditional expectation. -/
lemma integral_μ₁_mul_θ₁ : ∫ ω, E.μ₁ ω * E.θ₁ ω ∂P = ∫ ω, E.μ₁ ω ^ 2 ∂P := by
  have hpull : P[E.μ₁ * E.θ₁ | E.F₁] =ᵐ[P] E.μ₁ * P[E.θ₁ | E.F₁] :=
    condExp_mul_of_stronglyMeasurable_left stronglyMeasurable_condExp
      (E.memLp_μ₁.integrable_mul E.L2₁) (E.L2₁.integrable one_le_two)
  calc ∫ ω, E.μ₁ ω * E.θ₁ ω ∂P = ∫ ω, (P[E.μ₁ * E.θ₁ | E.F₁]) ω ∂P :=
        (integral_condExp E.hF₁le).symm
    _ = ∫ ω, (E.μ₁ * P[E.θ₁ | E.F₁]) ω ∂P := integral_congr_ae hpull
    _ = ∫ ω, E.μ₁ ω ^ 2 ∂P := by congr 1; ext ω; simp [μ₁, sq]

lemma integral_ε₁_mul_μ₁ : ∫ ω, (E.θ₁ ω - E.μ₁ ω) * E.μ₁ ω ∂P = 0 := by
  have h1 : Integrable (fun ω => E.θ₁ ω * E.μ₁ ω) P := E.L2₁.integrable_mul E.memLp_μ₁
  have h2 : Integrable (fun ω => E.μ₁ ω * E.μ₁ ω) P := E.memLp_μ₁.integrable_mul E.memLp_μ₁
  simp_rw [sub_mul]
  rw [integral_sub h1 h2]
  have := E.integral_μ₁_mul_θ₁
  simp_rw [mul_comm (E.θ₁ _) (E.μ₁ _)]
  rw [this]; simp [sq]

lemma integral_μ₁_sq : ∫ ω, E.μ₁ ω ^ 2 ∂P = E.s₁ - E.c₁ := by
  unfold s₁ c₁
  have hθ : Integrable (fun ω => E.θ₁ ω ^ 2) P := E.L2₁.integrable_sq
  have hμ : Integrable (fun ω => E.μ₁ ω ^ 2) P := E.memLp_μ₁.integrable_sq
  have hθμ : Integrable (fun ω => E.μ₁ ω * E.θ₁ ω) P := E.memLp_μ₁.integrable_mul E.L2₁
  have hpt : ∀ ω, (E.θ₁ ω - E.μ₁ ω) ^ 2 = E.θ₁ ω ^ 2 - 2 * (E.μ₁ ω * E.θ₁ ω) + E.μ₁ ω ^ 2 := by
    intro ω; ring
  simp_rw [hpt]
  have hA : Integrable (fun ω => E.θ₁ ω ^ 2 - 2 * (E.μ₁ ω * E.θ₁ ω)) P := hθ.sub (hθμ.const_mul 2)
  have hB : Integrable (fun ω => 2 * (E.μ₁ ω * E.θ₁ ω)) P := hθμ.const_mul 2
  rw [integral_add hA hμ, integral_sub hθ hB, integral_const_mul, E.integral_μ₁_mul_θ₁]
  ring

lemma integral_μ₂_sq : ∫ ω, E.μ₂ ω ^ 2 ∂P = E.s₂ - E.c₂ := E.swap.integral_μ₁_sq

/-- Functions of a unit's own state are independent of functions of the other unit's state. -/
lemma indepFun_of_comap {X Y : Ω → ℝ}
    (hX : Measurable[MeasurableSpace.comap E.θ₁ inferInstance] X)
    (hY : Measurable[MeasurableSpace.comap E.θ₂ inferInstance] Y) : IndepFun X Y P := by
  have h : Indep (MeasurableSpace.comap E.θ₁ inferInstance)
      (MeasurableSpace.comap E.θ₂ inferInstance) P := E.indep
  exact indep_of_indep_of_le_right (indep_of_indep_of_le_left h hX.comap_le) hY.comap_le

lemma meas_μ₁ : Measurable[MeasurableSpace.comap E.θ₁ inferInstance] E.μ₁ :=
  (stronglyMeasurable_condExp (m := E.F₁)).measurable.mono E.hF₁ le_rfl
lemma meas_μ₂ : Measurable[MeasurableSpace.comap E.θ₂ inferInstance] E.μ₂ :=
  (stronglyMeasurable_condExp (m := E.F₂)).measurable.mono E.hF₂ le_rfl
lemma meas_θ₁ : Measurable[MeasurableSpace.comap E.θ₁ inferInstance] E.θ₁ := comap_measurable _
lemma meas_θ₂ : Measurable[MeasurableSpace.comap E.θ₂ inferInstance] E.θ₂ := comap_measurable _

/-- Cross moments between the two units' variables vanish. -/
lemma integral_cross {X Y : Ω → ℝ}
    (hX : Measurable[MeasurableSpace.comap E.θ₁ inferInstance] X)
    (hY : Measurable[MeasurableSpace.comap E.θ₂ inferInstance] Y)
    (hXm : AEStronglyMeasurable X P) (hYm : AEStronglyMeasurable Y P)
    (hX0 : ∫ ω, X ω ∂P = 0) : ∫ ω, X ω * Y ω ∂P = 0 := by
  rw [(E.indepFun_of_comap hX hY).integral_fun_mul_eq_mul_integral hXm hYm, hX0, zero_mul]

/-! #### The orthogonal decomposition -/

/-- The four orthogonal components `ε₁, μ₁, ε₂, μ₂`. -/
noncomputable def Z : Fin 4 → Ω → ℝ :=
  ![fun ω => E.θ₁ ω - E.μ₁ ω, E.μ₁, fun ω => E.θ₂ ω - E.μ₂ ω, E.μ₂]

/-- Their second moments `c₁, σ₁² - c₁, c₂, σ₂² - c₂`. -/
noncomputable def v : Fin 4 → ℝ := ![E.c₁, E.s₁ - E.c₁, E.c₂, E.s₂ - E.c₂]

lemma memLp_Z (k : Fin 4) : MemLp (E.Z k) 2 P := by
  fin_cases k
  · exact E.memLp_ε₁
  · exact E.memLp_μ₁
  · exact E.memLp_ε₂
  · exact E.memLp_μ₂

lemma meas_Z₁ (k : Fin 4) (hk : k.val < 2) :
    Measurable[MeasurableSpace.comap E.θ₁ inferInstance] (E.Z k) := by
  fin_cases k
  · exact E.meas_θ₁.sub E.meas_μ₁
  · exact E.meas_μ₁
  · simp at hk
  · simp at hk

lemma meas_Z₂ (k : Fin 4) (hk : 2 ≤ k.val) :
    Measurable[MeasurableSpace.comap E.θ₂ inferInstance] (E.Z k) := by
  fin_cases k
  · simp at hk
  · simp at hk
  · exact E.meas_θ₂.sub E.meas_μ₂
  · exact E.meas_μ₂

lemma integral_Z (k : Fin 4) : ∫ ω, E.Z k ω ∂P = 0 := by
  fin_cases k
  · simp only [Z]
    show ∫ ω, (E.θ₁ ω - E.μ₁ ω) ∂P = 0
    rw [integral_sub (E.L2₁.integrable one_le_two) (E.memLp_μ₁.integrable one_le_two), E.mean₁,
      E.integral_μ₁, sub_zero]
  · exact E.integral_μ₁
  · show ∫ ω, (E.θ₂ ω - E.μ₂ ω) ∂P = 0
    rw [integral_sub (E.L2₂.integrable one_le_two) (E.memLp_μ₂.integrable one_le_two), E.mean₂,
      E.integral_μ₂, sub_zero]
  · exact E.integral_μ₂

lemma integral_Z_mul (k l : Fin 4) :
    ∫ ω, E.Z k ω * E.Z l ω ∂P = if k = l then E.v k else 0 := by
  have hae : ∀ k, AEStronglyMeasurable (E.Z k) P := fun k => (E.memLp_Z k).aestronglyMeasurable
  have cross : ∀ k l : Fin 4, k.val < 2 → 2 ≤ l.val → ∫ ω, E.Z k ω * E.Z l ω ∂P = 0 :=
    fun k l hk hl => E.integral_cross (E.meas_Z₁ k hk) (E.meas_Z₂ l hl) (hae k) (hae l)
      (E.integral_Z k)
  have cross' : ∀ k l : Fin 4, k.val < 2 → 2 ≤ l.val → ∫ ω, E.Z l ω * E.Z k ω ∂P = 0 := by
    intro k l hk hl; simp_rw [mul_comm (E.Z l _)]; exact cross k l hk hl
  have e1 : ∫ ω, E.Z 0 ω * E.Z 1 ω ∂P = 0 := E.integral_ε₁_mul_μ₁
  have e1' : ∫ ω, E.Z 1 ω * E.Z 0 ω ∂P = 0 := by simp_rw [mul_comm (E.Z 1 _)]; exact e1
  have e2 : ∫ ω, E.Z 2 ω * E.Z 3 ω ∂P = 0 := E.swap.integral_ε₁_mul_μ₁
  have e2' : ∫ ω, E.Z 3 ω * E.Z 2 ω ∂P = 0 := by simp_rw [mul_comm (E.Z 3 _)]; exact e2
  have d0 : ∫ ω, E.Z 0 ω * E.Z 0 ω ∂P = E.c₁ := by simp only [Z, c₁]; simp [sq]
  have d1 : ∫ ω, E.Z 1 ω * E.Z 1 ω ∂P = E.s₁ - E.c₁ := by
    rw [← E.integral_μ₁_sq]; simp [Z, sq]
  have d2 : ∫ ω, E.Z 2 ω * E.Z 2 ω ∂P = E.c₂ := by simp only [Z, c₂]; simp [sq]
  have d3 : ∫ ω, E.Z 3 ω * E.Z 3 ω ∂P = E.s₂ - E.c₂ := by
    rw [← E.integral_μ₂_sq]; simp [Z, sq]
  fin_cases k <;> fin_cases l <;> simp [v, d0, d1, d2, d3, e1, e1', e2, e2',
    cross 0 2 (by decide) (by decide), cross 0 3 (by decide) (by decide),
    cross 1 2 (by decide) (by decide), cross 1 3 (by decide) (by decide),
    cross' 0 2 (by decide) (by decide), cross' 0 3 (by decide) (by decide),
    cross' 1 2 (by decide) (by decide), cross' 1 3 (by decide) (by decide)]

/-- The second moment of a linear combination of the orthogonal components. -/
lemma integral_lin_sq (a : Fin 4 → ℝ) :
    ∫ ω, (∑ k, a k * E.Z k ω) ^ 2 ∂P = ∑ k, a k ^ 2 * E.v k := by
  have hint : ∀ k l, Integrable (fun ω => E.Z k ω * E.Z l ω) P :=
    fun k l => (E.memLp_Z k).integrable_mul (E.memLp_Z l)
  have hpt : ∀ ω, (∑ k, a k * E.Z k ω) ^ 2 =
      ∑ k, ∑ l, a k * a l * (E.Z k ω * E.Z l ω) := by
    intro ω; rw [sq, Finset.sum_mul_sum]
    refine Finset.sum_congr rfl (fun k _ => Finset.sum_congr rfl (fun l _ => by ring))
  simp_rw [hpt]
  rw [integral_finsetSum _ (fun k _ => integrable_finsetSum _ (fun l _ => (hint k l).const_mul _))]
  refine Finset.sum_congr rfl (fun k _ => ?_)
  rw [integral_finsetSum _ (fun l _ => (hint k l).const_mul _)]
  simp_rw [MeasureTheory.integral_const_mul, E.integral_Z_mul]
  simp [sq]

/-- Expected loss `𝔼 ℒ(d, d', θ)` when the adaptation gap `θ - d` and the coordination gap
`d' - d` are linear combinations of the orthogonal components. -/
lemma integral_L_lin (r : ℝ) (d d' θ : Ω → ℝ) (u w : Fin 4 → ℝ)
    (hu : ∀ ω, θ ω - d ω = ∑ k, u k * E.Z k ω) (hw : ∀ ω, d' ω - d ω = ∑ k, w k * E.Z k ω) :
    ∫ ω, L r (d ω) (d' ω) (θ ω) ∂P = (1 - r) * ∑ k, u k ^ 2 * E.v k + r * ∑ k, w k ^ 2 * E.v k := by
  have hint : ∀ a : Fin 4 → ℝ, Integrable (fun ω => (∑ k, a k * E.Z k ω) ^ 2) P := by
    intro a
    have : MemLp (fun ω => ∑ k, a k * E.Z k ω) 2 P :=
      memLp_finsetSum (Finset.univ : Finset (Fin 4)) (fun k _ => (E.memLp_Z k).const_mul (a k))
    exact this.integrable_sq
  have hpt : ∀ ω, L r (d ω) (d' ω) (θ ω) =
      (1 - r) * (∑ k, u k * E.Z k ω) ^ 2 + r * (∑ k, w k * E.Z k ω) ^ 2 := by
    intro ω; unfold L; rw [← hu, ← hw]
  simp_rw [hpt]
  rw [integral_add ((hint u).const_mul _) ((hint w).const_mul _), integral_const_mul,
    integral_const_mul, E.integral_lin_sq, E.integral_lin_sq]

lemma integral_sq_lin (d : Ω → ℝ) (u : Fin 4 → ℝ) (hu : ∀ ω, d ω = ∑ k, u k * E.Z k ω) :
    ∫ ω, d ω ^ 2 ∂P = ∑ k, u k ^ 2 * E.v k := by
  simp_rw [hu]; exact E.integral_lin_sq u

/-- `integral_L_lin` with the four coefficients written out, on `θ₁ - μ₁, μ₁, θ₂ - μ₂, μ₂`. -/
lemma integral_L_lin4 (r : ℝ) (d d' θ : Ω → ℝ) (u0 u1 u2 u3 w0 w1 w2 w3 : ℝ)
    (hu : ∀ ω, θ ω - d ω = u0 * (E.θ₁ ω - E.μ₁ ω) + u1 * E.μ₁ ω + u2 * (E.θ₂ ω - E.μ₂ ω)
      + u3 * E.μ₂ ω)
    (hw : ∀ ω, d' ω - d ω = w0 * (E.θ₁ ω - E.μ₁ ω) + w1 * E.μ₁ ω + w2 * (E.θ₂ ω - E.μ₂ ω)
      + w3 * E.μ₂ ω) :
    ∫ ω, L r (d ω) (d' ω) (θ ω) ∂P =
      (1 - r) * (u0 ^ 2 * E.c₁ + u1 ^ 2 * (E.s₁ - E.c₁) + u2 ^ 2 * E.c₂ + u3 ^ 2 * (E.s₂ - E.c₂))
        + r * (w0 ^ 2 * E.c₁ + w1 ^ 2 * (E.s₁ - E.c₁) + w2 ^ 2 * E.c₂
          + w3 ^ 2 * (E.s₂ - E.c₂)) := by
  rw [E.integral_L_lin r d d' θ ![u0, u1, u2, u3] ![w0, w1, w2, w3]]
  · simp [Fin.sum_univ_four, v]
  · intro ω; rw [hu ω]; simp [Fin.sum_univ_four, Z]
  · intro ω; rw [hw ω]; simp [Fin.sum_univ_four, Z]

/-- `integral_sq_lin` with the four coefficients written out. -/
lemma integral_sq_lin4 (d : Ω → ℝ) (u0 u1 u2 u3 : ℝ)
    (hu : ∀ ω, d ω = u0 * (E.θ₁ ω - E.μ₁ ω) + u1 * E.μ₁ ω + u2 * (E.θ₂ ω - E.μ₂ ω)
      + u3 * E.μ₂ ω) :
    ∫ ω, d ω ^ 2 ∂P =
      u0 ^ 2 * E.c₁ + u1 ^ 2 * (E.s₁ - E.c₁) + u2 ^ 2 * E.c₂ + u3 ^ 2 * (E.s₂ - E.c₂) := by
  rw [E.integral_sq_lin d ![u0, u1, u2, u3]]
  · simp [Fin.sum_univ_four, v]
  · intro ω; rw [hu ω]; simp [Fin.sum_univ_four, Z]

/-! ### Lemma 3 -/

variable {r₁ r₂ : ℝ}

/-- The identities behind equations (2) and (3): with `γ = β/((1 - r) + β)`,
`(1 - r) γ² + β (1 - γ)² = (1 - r) γ` and `β - (1 - r) γ = γ β`. -/
lemma γ_identities (h₁ : Unit01 r₁) (h₂ : Unit01 r₂) :
    (1 - r₁) * γ r₁ r₂ ^ 2 + β r₁ r₂ * (1 - γ r₁ r₂) ^ 2 = (1 - r₁) * γ r₁ r₂ ∧
      β r₁ r₂ - (1 - r₁) * γ r₁ r₂ = γ r₁ r₂ * β r₁ r₂ := by
  have hden := den_γ_pos h₁ h₂
  constructor <;> (unfold γ; field_simp; ring)

/-- Equation (2): under sequential decision-making with unit 1 leading, the leader's
expected loss is `(1 - r₁) γ₁ (σ₁² + σ₂²) + γ₁ β₁ c₂`. -/
lemma leader_loss_eq (h₁ : Unit01 r₁) (h₂ : Unit01 r₂) :
    ∫ ω, L r₁ (E.seqD₁ r₁ r₂ ω) (E.seqD₂ r₁ r₂ ω) (E.θ₁ ω) ∂P =
      leaderLossF r₁ r₂ E.s₁ E.s₂ E.c₂ := by
  set g := γ r₁ r₂ with hg
  rw [E.integral_L_lin4 r₁ _ _ _ g g 0 (-g)
    (-(1 - r₂) * (1 - g)) (-(1 - r₂) * (1 - g)) (1 - r₂) ((1 - r₂) * (1 - g))]
  · obtain ⟨k1, k2⟩ := γ_identities h₁ h₂
    rw [← hg] at k1 k2
    unfold leaderLossF; rw [← hg]
    have hβ : β r₁ r₂ = r₁ * (1 - r₂) ^ 2 := rfl
    rw [hβ] at k1 k2 ⊢
    linear_combination (E.s₁ + E.s₂ - E.c₂) * k1 + E.c₂ * k2
  · intro ω; simp only [seqD₁]; ring
  · intro ω; simp only [seqD₂, seqD₁]; ring

/-- Equation (3): under sequential decision-making with unit 1 leading, the
follower's expected loss is `(1 - r₂) r₂ (1 - γ₁)² (σ₁² + σ₂²) - (1 - r₂) r₂ (γ₁² - 2γ₁) c₂`. -/
lemma follower_loss_eq :
    ∫ ω, L r₂ (E.seqD₂ r₁ r₂ ω) (E.seqD₁ r₁ r₂ ω) (E.θ₂ ω) ∂P =
      followerLossF r₁ r₂ E.s₁ E.s₂ E.c₂ := by
  set g := γ r₁ r₂ with hg
  rw [E.integral_L_lin4 r₂ _ _ _ (-r₂ * (1 - g)) (-r₂ * (1 - g)) r₂ (r₂ * (1 - g))
    ((1 - r₂) * (1 - g)) ((1 - r₂) * (1 - g)) (-(1 - r₂)) (-(1 - r₂) * (1 - g))]
  · unfold followerLossF; rw [← hg]; ring
  · intro ω; simp only [seqD₂, seqD₁]; ring
  · intro ω; simp only [seqD₂, seqD₁]; ring

/-! ### Lemma 4 -/

lemma eOwn_eq (h₁ : Unit01 r₁) (h₂ : Unit01 r₂) : eOwn r₁ r₂ = r₁ - bOth r₁ r₂ := by
  have := Dn_pos h₁ h₂
  unfold eOwn bOth; field_simp; unfold Dn; ring

lemma Kc_eq₁ (h₁ : Unit01 r₁) (h₂ : Unit01 r₂) : 1 - r₁ + eOwn r₁ r₂ - bOth r₂ r₁ = Kc r₁ r₂ := by
  have := Dn_pos h₁ h₂
  have hD' : Dn r₂ r₁ = Dn r₁ r₂ := by unfold Dn; ring
  unfold eOwn bOth Kc; rw [hD']; field_simp; unfold Dn; ring

lemma Kc_eq₂ (h₁ : Unit01 r₁) (h₂ : Unit01 r₂) : 1 - r₂ + eOwn r₂ r₁ - bOth r₁ r₂ = Kc r₁ r₂ := by
  have := Dn_pos h₁ h₂
  have hD' : Dn r₂ r₁ = Dn r₁ r₂ := by unfold Dn; ring
  unfold eOwn bOth Kc; rw [hD']; field_simp; unfold Dn; ring

/-- Unit 1's expected loss under concurrent decision-making:
`(σ₁² + σ₂²)(1 - r₁)β₁/(1 - r₁r₂)² + r₁(1 - r₁)((1 - r₁r₂)² - (1 - r₂)²)/(1 - r₁r₂)² · c₁
  + r₁(1 - r₂)²((1 - r₁r₂)² - (1 - r₁))/(1 - r₁r₂)² · c₂`. -/
lemma conc_loss_eq (h₁ : Unit01 r₁) (h₂ : Unit01 r₂) :
    ∫ ω, L r₁ (E.concD₁ r₁ r₂ ω) (E.concD₂ r₁ r₂ ω) (E.θ₁ ω) ∂P =
      concLossF r₁ r₂ E.s₁ E.s₂ E.c₁ E.c₂ := by
  have hD := Dn_pos h₁ h₂
  rw [E.integral_L_lin4 r₁ _ _ _ r₁ (bOth r₁ r₂) 0 (-bOth r₁ r₂)
    (-(1 - r₁)) (-Kc r₁ r₂) (1 - r₂) (Kc r₁ r₂)]
  · unfold concLossF bOth Kc β
    field_simp
    unfold Dn; ring
  · intro ω; simp only [concD₁, concRule]; rw [eOwn_eq h₁ h₂]; ring
  · intro ω; simp only [concD₁, concD₂, concRule]
    linear_combination (-E.μ₁ ω) * Kc_eq₁ h₁ h₂ + (E.μ₂ ω) * Kc_eq₂ h₁ h₂

/-- Unit 2's expected loss under concurrent decision-making, by exchanging the labels. -/
lemma conc_loss_eq₂ (h₁ : Unit01 r₁) (h₂ : Unit01 r₂) :
    ∫ ω, L r₂ (E.concD₂ r₁ r₂ ω) (E.concD₁ r₁ r₂ ω) (E.θ₂ ω) ∂P =
      concLossF r₂ r₁ E.s₂ E.s₁ E.c₂ E.c₁ :=
  E.swap.conc_loss_eq h₂ h₁

/-! ### Coordination losses -/

/-- Expected coordination loss under sequential decision-making, unit 1 leading. -/
lemma coord_seq :
    ∫ ω, (E.seqD₁ r₁ r₂ ω - E.seqD₂ r₁ r₂ ω) ^ 2 ∂P = coordSeqF r₁ r₂ E.s₁ E.s₂ E.c₂ := by
  set g := γ r₁ r₂ with hg
  rw [E.integral_sq_lin4 _ ((1 - r₂) * (1 - g)) ((1 - r₂) * (1 - g)) (-(1 - r₂))
    (-(1 - r₂) * (1 - g))]
  · unfold coordSeqF; rw [← hg]; ring
  · intro ω; simp only [seqD₂, seqD₁]; ring

/-! ### No communication and full revelation -/

/-- Without communication (`F = ⊥`) the information loss is the whole variance: `c₁ = σ₁²`. -/
lemma c₁_eq_of_bot (h : E.F₁ = ⊥) : E.c₁ = E.s₁ := by
  unfold c₁ s₁ μ₁; rw [h, condExp_bot, E.mean₁]; simp

lemma c₂_eq_of_bot (h : E.F₂ = ⊥) : E.c₂ = E.s₂ := E.swap.c₁_eq_of_bot h

/-- When the message reveals the state (`F = σ(θ)`) the information loss is zero. -/
lemma c₁_eq_of_full (h : E.F₁ = MeasurableSpace.comap E.θ₁ inferInstance) : E.c₁ = 0 := by
  unfold c₁ μ₁
  have hsm : StronglyMeasurable[E.F₁] E.θ₁ := by
    rw [h]; exact (comap_measurable E.θ₁).stronglyMeasurable
  rw [condExp_of_stronglyMeasurable E.hF₁le hsm (E.L2₁.integrable one_le_two)]; simp

lemma c₂_eq_of_full (h : E.F₂ = MeasurableSpace.comap E.θ₂ inferInstance) : E.c₂ = 0 :=
  E.swap.c₁_eq_of_full h

lemma c₁_nonneg : 0 ≤ E.c₁ := integral_nonneg fun _ => sq_nonneg _
lemma c₂_nonneg : 0 ≤ E.c₂ := integral_nonneg fun _ => sq_nonneg _
lemma c₁_le : E.c₁ ≤ E.s₁ := by
  have := E.integral_μ₁_sq
  have : 0 ≤ ∫ ω, E.μ₁ ω ^ 2 ∂P := integral_nonneg fun _ => sq_nonneg _
  linarith
lemma c₂_le : E.c₂ ≤ E.s₂ := E.swap.c₁_le

end Env

