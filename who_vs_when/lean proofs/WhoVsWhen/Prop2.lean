import WhoVsWhen.Lemma2

/-!
# Proposition 2: aggregate information loss

The main result is `prop2`. The information losses are those of Lemma 2: the limit partitions with
uniform states on `[-θ̄ᵢ, θ̄ᵢ]`, and volatilities `σᵢ² = θ̄ᵢ²/3` (`uniformVar`). Under sequential
decision-making the leader's state is revealed (Lemma 2), so the aggregate information loss is the
follower's alone.
-/

namespace WhoVsWhen

variable {r₁ r₂ : ℝ}

/-- Information loss about the follower's state, unit `L` leading (Lemma 2): the loss of the
limit partition generated by the follower's indifference condition. -/
noncomputable def cSeq (θbarF rL rF : ℝ) : ℝ :=
  infoLoss θbarF (geomPartition θbarF (φSeq rL rF)) (geomPartition θbarF (φSeq rL rF))

/-- Information loss about unit `i`'s state under concurrent decision-making (Lemma 2). -/
noncomputable def cConc (θbari ri rj : ℝ) : ℝ :=
  infoLoss θbari (geomPartition θbari (φConc ri rj)) (geomPartition θbari (φConc ri rj))

/-- Aggregate information loss, sequential, unit 1 leading: `0` about the leader's state plus the
loss about the follower's state. -/
noncomputable def aggSeq₁ (_θbar₁ θbar₂ r₁ r₂ : ℝ) : ℝ := 0 + cSeq θbar₂ r₁ r₂
/-- Aggregate information loss, sequential, unit 2 leading. -/
noncomputable def aggSeq₂ (θbar₁ _θbar₂ r₁ r₂ : ℝ) : ℝ := cSeq θbar₁ r₂ r₁ + 0
/-- Aggregate information loss, concurrent. -/
noncomputable def aggConc (θbar₁ θbar₂ r₁ r₂ : ℝ) : ℝ := cConc θbar₁ r₁ r₂ + cConc θbar₂ r₂ r₁

lemma cSeq_eq (hL : Unit01 r₁) (hF : Unit01 r₂) {θbar : ℝ} (hθ : 0 < θbar) :
    cSeq θbar r₁ r₂ = uniformVar θbar * V (φSeq r₁ r₂) :=
  infoLoss_geometric (φSeq_pos hL hF) hθ

lemma cConc_eq (hi : Unit01 r₁) (hj : Unit01 r₂) {θbar : ℝ} (hθ : 0 < θbar) :
    cConc θbar r₁ r₂ = uniformVar θbar * V (φConc r₁ r₂) :=
  infoLoss_geometric (φConc_pos hi hj) hθ

/-- The product of the two concurrent `φ`s is `r₁ r₂` (proof of Proposition 2(i)). -/
lemma φConc_mul (h₁ : Unit01 r₁) (h₂ : Unit01 r₂) : φConc r₁ r₂ * φConc r₂ r₁ = r₁ * r₂ := by
  have : (1 : ℝ) - r₁ ≠ 0 := by linarith [h₁.2]
  have : (1 : ℝ) - r₂ ≠ 0 := by linarith [h₂.2]
  unfold φConc; field_simp

/-- `V x + V y > 1/4` whenever `x y < 16/9` (proof of Proposition 2(i)). -/
lemma V_add_gt {x y : ℝ} (hx : 0 < x) (hy : 0 < y) (hxy : x * y < 16 / 9) : 1 / 4 < V x + V y := by
  unfold V
  rw [div_add_div _ _ (by positivity) (by positivity), lt_div_iff₀ (by positivity)]
  nlinarith

/-- `φ_{F,sequential} = (1 - r_F) φ_{F,concurrent} < φ_{F,concurrent}`: the leader responds less
to the follower's message than under concurrent decision-making. -/
lemma φSeq_lt_φConc (hL : Unit01 r₁) (hF : Unit01 r₂) : φSeq r₁ r₂ < φConc r₂ r₁ := by
  have : φSeq r₁ r₂ = (1 - r₂) * φConc r₂ r₁ := by
    have : (1 : ℝ) - r₁ ≠ 0 := by linarith [hL.2]
    unfold φSeq φConc β; field_simp
  rw [this]
  have := φConc_pos hF hL
  nlinarith [hF.1]

lemma uniformVar_pos {θbar : ℝ} (hθ : 0 < θbar) : 0 < uniformVar θbar := by
  rw [uniformVar_eq hθ]; positivity

/-- Part (i) when unit 1 is at least as volatile as unit 2: sequential decision-making
with unit 1 leading induces strictly less aggregate information loss than concurrent
decision-making, despite strictly worse information loss about the follower's state. -/
lemma agg_lt_of_le (h₁ : Unit01 r₁) (h₂ : Unit01 r₂) {θbar₁ θbar₂ : ℝ} (hθ₁ : 0 < θbar₁)
    (hθ₂ : 0 < θbar₂) (hvol : uniformVar θbar₂ ≤ uniformVar θbar₁) :
    aggSeq₁ θbar₁ θbar₂ r₁ r₂ < aggConc θbar₁ θbar₂ r₁ r₂ ∧
      cConc θbar₂ r₂ r₁ < cSeq θbar₂ r₁ r₂ := by
  unfold aggSeq₁ aggConc
  rw [cSeq_eq h₁ h₂ hθ₂, cConc_eq h₁ h₂ hθ₁, cConc_eq h₂ h₁ hθ₂]
  have hv₂ := uniformVar_pos hθ₂
  have p1 := φConc_pos h₁ h₂
  have p2 := φConc_pos h₂ h₁
  have pS := φSeq_pos h₁ h₂
  constructor
  · have hsum : 1 / 4 < V (φConc r₁ r₂) + V (φConc r₂ r₁) := by
      apply V_add_gt p1 p2
      rw [φConc_mul h₁ h₂]; nlinarith [h₁.1, h₂.1, h₁.2, h₂.2]
    have hS := V_lt_quarter pS
    have hV1 := V_pos p1.le
    nlinarith [mul_le_mul_of_nonneg_right hvol hV1.le]
  · exact mul_lt_mul_of_pos_left (V_strictAnti pS.le (φSeq_lt_φConc h₁ h₂)) hv₂

/-- Part (i): there is an order of the units under which sequential decision-making
induces strictly less aggregate information loss than concurrent decision-making, and under that
order the information loss about the follower's state is strictly worse. -/
lemma order_exists (h₁ : Unit01 r₁) (h₂ : Unit01 r₂) {θbar₁ θbar₂ : ℝ} (hθ₁ : 0 < θbar₁)
    (hθ₂ : 0 < θbar₂) :
    (aggSeq₁ θbar₁ θbar₂ r₁ r₂ < aggConc θbar₁ θbar₂ r₁ r₂ ∧
        cConc θbar₂ r₂ r₁ < cSeq θbar₂ r₁ r₂) ∨
      (aggSeq₂ θbar₁ θbar₂ r₁ r₂ < aggConc θbar₁ θbar₂ r₁ r₂ ∧
        cConc θbar₁ r₁ r₂ < cSeq θbar₁ r₂ r₁) := by
  rcases le_total (uniformVar θbar₂) (uniformVar θbar₁) with h | h
  · exact Or.inl (agg_lt_of_le h₁ h₂ hθ₁ hθ₂ h)
  · right
    have := agg_lt_of_le h₂ h₁ hθ₂ hθ₁ h
    unfold aggSeq₁ aggConc at this
    unfold aggSeq₂ aggConc
    constructor
    · linarith [this.1]
    · exact this.2

/-- The step in the proof of Proposition 2(ii): `β₁/(1 - r₁) > β₂/(1 - r₂)` iff `r₁ > r₂`. -/
lemma φSeq_lt_iff (h₁ : Unit01 r₁) (h₂ : Unit01 r₂) : φSeq r₂ r₁ < φSeq r₁ r₂ ↔ r₂ < r₁ := by
  have hu : 0 < 1 - r₁ := by linarith [h₁.2]
  have hv : 0 < 1 - r₂ := by linarith [h₂.2]
  unfold φSeq β
  rw [div_lt_div_iff₀ hv hu]
  have key : r₁ * (1 - r₂) ^ 2 * (1 - r₂) - r₂ * (1 - r₁) ^ 2 * (1 - r₁) =
      r₁ * (1 - r₂) ^ 3 - r₂ * (1 - r₁) ^ 3 := by ring
  constructor
  · intro h
    by_contra hr
    have hr' := not_lt.mp hr
    have a : r₁ * (1 - r₂) ^ 3 ≤ r₂ * (1 - r₁) ^ 3 := by
      have c1 : (1 - r₂) ^ 3 ≤ (1 - r₁) ^ 3 := pow_le_pow_left₀ hv.le (by linarith) 3
      have c2 : 0 ≤ (1 - r₂) ^ 3 := by positivity
      nlinarith [mul_le_mul_of_nonneg_right hr' c2, mul_le_mul_of_nonneg_left c1 h₂.1.le]
    nlinarith
  · intro h
    have c1 : (1 - r₁) ^ 3 < (1 - r₂) ^ 3 := pow_lt_pow_left₀ (by linarith) hu.le (by norm_num)
    have c2 : 0 < (1 - r₂) ^ 3 := by positivity
    nlinarith [mul_lt_mul_of_pos_right h c2, mul_lt_mul_of_pos_left c1 h₂.1]

/-- Part (ii): with equal volatility, unit 1 leading induces less aggregate information
loss than unit 2 leading iff `r₁ > r₂`. -/
lemma equalVol_iff (h₁ : Unit01 r₁) (h₂ : Unit01 r₂) {θbar : ℝ} (hθ : 0 < θbar) :
    aggSeq₁ θbar θbar r₁ r₂ < aggSeq₂ θbar θbar r₁ r₂ ↔ r₂ < r₁ := by
  unfold aggSeq₁ aggSeq₂
  rw [cSeq_eq h₁ h₂ hθ, cSeq_eq h₂ h₁ hθ, zero_add, add_zero,
    mul_lt_mul_iff_of_pos_left (uniformVar_pos hθ), ← φSeq_lt_iff h₁ h₂]
  have p1 := φSeq_pos h₁ h₂
  have p2 := φSeq_pos h₂ h₁
  constructor
  · intro h
    by_contra hc
    rcases (not_lt.mp hc).lt_or_eq with hlt | heq
    · have := V_strictAnti p1.le hlt; linarith
    · rw [heq] at h; exact lt_irrefl _ h
  · intro h; exact V_strictAnti p2.le h

/-- Part (iii): with equal coordination weights, unit 1 leading induces less aggregate
information loss than unit 2 leading iff `σ₁² > σ₂²`. -/
lemma equalR_iff (h : Unit01 r₁) {θbar₁ θbar₂ : ℝ} (hθ₁ : 0 < θbar₁) (hθ₂ : 0 < θbar₂) :
    aggSeq₁ θbar₁ θbar₂ r₁ r₁ < aggSeq₂ θbar₁ θbar₂ r₁ r₁ ↔
      uniformVar θbar₂ < uniformVar θbar₁ := by
  unfold aggSeq₁ aggSeq₂
  rw [cSeq_eq h h hθ₂, cSeq_eq h h hθ₁, zero_add, add_zero]
  exact mul_lt_mul_iff_of_pos_right (V_pos (φSeq_pos h h).le)

/-- **Proposition 2.** Aggregate information loss, with the information losses of Lemma 2.

* (i) There is an order of the units under which sequential decision-making induces strictly less
  aggregate information loss than concurrent decision-making. Under that order the information
  loss about the follower's state is strictly worse than under concurrent decision-making.
* (ii) Given equal volatility, unit 1 leading induces less aggregate information loss than unit 2
  leading iff `r₁ > r₂`.
* (iii) Given equal coordination weights, unit 1 leading induces less aggregate information loss
  iff `σ₁² > σ₂²`. -/
theorem prop2 {θbar₁ θbar₂ : ℝ} (h₁ : Unit01 r₁) (h₂ : Unit01 r₂) (hθ₁ : 0 < θbar₁)
    (hθ₂ : 0 < θbar₂) :
    ((aggSeq₁ θbar₁ θbar₂ r₁ r₂ < aggConc θbar₁ θbar₂ r₁ r₂ ∧
          cConc θbar₂ r₂ r₁ < cSeq θbar₂ r₁ r₂) ∨
        (aggSeq₂ θbar₁ θbar₂ r₁ r₂ < aggConc θbar₁ θbar₂ r₁ r₂ ∧
          cConc θbar₁ r₁ r₂ < cSeq θbar₁ r₂ r₁)) ∧
      (uniformVar θbar₁ = uniformVar θbar₂ →
        (aggSeq₁ θbar₁ θbar₂ r₁ r₂ < aggSeq₂ θbar₁ θbar₂ r₁ r₂ ↔ r₂ < r₁)) ∧
      (r₁ = r₂ →
        (aggSeq₁ θbar₁ θbar₂ r₁ r₂ < aggSeq₂ θbar₁ θbar₂ r₁ r₂ ↔
          uniformVar θbar₂ < uniformVar θbar₁)) := by
  refine ⟨order_exists h₁ h₂ hθ₁ hθ₂, fun hv => ?_, fun hr => ?_⟩
  · have hθ : θbar₁ = θbar₂ := by
      rw [uniformVar_eq hθ₁, uniformVar_eq hθ₂] at hv
      have h3 : (θbar₁ - θbar₂) * (θbar₁ + θbar₂) = 0 := by linear_combination 3 * hv
      rcases mul_eq_zero.mp h3 with h | h
      · linarith
      · linarith
    subst hθ
    exact equalVol_iff h₁ h₂ hθ₁
  · subst hr
    exact equalR_iff h₁ hθ₁ hθ₂

end WhoVsWhen
